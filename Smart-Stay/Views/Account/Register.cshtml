@model Smart_Stay.Models.RegisterViewModel
@{
    ViewData["Title"] = "Register";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Smart Stay - Register</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/register.css" />
</head>
<body>

    <div class="register-wrapper">
        <div class="register-left">
            <h2 class="title">REGISTER ACCOUNT</h2>

            @if (ViewBag.AwaitingCode == true)
            {
                <h2 class="title">VERIFY YOUR EMAIL</h2>
                <p>We sent a 4-digit code to <strong>@ViewBag.PendingEmail</strong>. Enter it below.</p>

                @if (ViewBag.CodeError != null)
                {
                    <div class="field-error"><p>@ViewBag.CodeError</p></div>
                }

                <form asp-controller="Account" asp-action="VerifyCode" method="post">
                    <input type="hidden" name="Token" value="@ViewBag.Token" />

                    <label class="field-label">4-Digit Code <span class="required">*Required</span></label>
                    <div class="input-group">
                        <i class="fa-solid fa-key"></i>
                        <input type="text" name="Code" maxlength="4" pattern="\d{4}" inputmode="numeric"
                               placeholder="0000" required style="letter-spacing:6px; text-align:center;" />
                    </div>

                    <button type="submit" class="btn-register">Verify Code</button>
                </form>
            }
            else
            {
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="field-error">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <p>@error.ErrorMessage</p>
                        }
                    </div>
                }

                <form asp-controller="Account" asp-action="Register" method="post">
                    <div class="role-toggle">
                        <label>
                            <input type="radio" name="Role" value="Tenant" checked />
                            <span><i class="fa-solid fa-user"></i> TENANT</span>
                        </label>
                        <label>
                            <input type="radio" name="Role" value="Landlord" />
                            <span><i class="fa-solid fa-house"></i> LANDLORD</span>
                        </label>
                        <label>
                            <input type="radio" name="Role" value="Admin" />
                            <span><i class="fa-solid fa-user-tie"></i> ADMIN</span>
                        </label>
                    </div>

                    <label class="field-label">Name and Surname <span class="required">*Required</span></label>
                    <div class="input-group">
                        <i class="fa-solid fa-user"></i>
                        <input type="text" name="FullName" placeholder="Enter your name and surname" required />
                    </div>

                    <label class="field-label">Email Address <span class="required">*Required</span></label>
                    <div class="input-group">
                        <i class="fa-solid fa-envelope"></i>
                        <input type="email" name="Email" placeholder="Enter your email" required value="@Model?.Email" />
                    </div>
                    @if (ViewBag.EmailTaken == true)
                    {
                        <div class="field-error">⚠ This email is already registered! Try to login.</div>
                    }

                    <label class="field-label">Phone Number <span class="required">*Required</span></label>
                    <div class="input-group">
                        <i class="fa-solid fa-phone"></i>
                        <input type="text" name="PhoneNo" placeholder="Phone number e.g 0786739981" required />
                    </div>

                    <div id="tenantFields" style="display:none;">
                        <label class="field-label">Employment Status</label>
                        <div class="input-group">
                            <i class="fa-solid fa-briefcase"></i>
                            <select name="EmploymentStatus" style="width:100%; padding:10px 40px; border:1px solid #ccc; border-radius:4px; font-size:14px;">
                                <option value="Employed">Employed</option>
                                <option value="Self-employed">Self-employed</option>
                                <option value="Unemployed">Unemployed</option>
                                <option value="Student">Student</option>
                            </select>
                        </div>
                    </div>

                    <div id="landlordFields" style="display:none;">
                        <p style="font-size:13px; color:#666; margin-bottom:15px;">
                            <i class="fa-solid fa-circle-info"></i> Your landlord account will be reviewed and verified by our team before you can list properties.
                        </p>
                    </div>

                    <label class="field-label">Password <span class="required">*Required</span></label>
                    <div class="input-group">
                        <i class="fa-solid fa-lock"></i>
                        <input type="password" name="Password" id="passwordField"
                               placeholder="Enter a strong password" required
                               pattern="^(?=.*[A-Z])(?=.*\d)(?=.*[!@@#$%^&amp;*(),.?&quot;:{}|&lt;&gt;]).{8,}$"
                               title="At least 8 characters, 1 uppercase letter, 1 number, and 1 special character" />
                        <i class="fa-solid fa-eye toggle-eye" onclick="toggleField('passwordField')"></i>
                    </div>
                    <ul id="pwdRules" class="pwd-rules">
                        <li id="ruleLength">At least 8 characters</li>
                        <li id="ruleUpper">1 uppercase letter</li>
                        <li id="ruleNumber">1 number</li>
                        <li id="ruleSpecial">1 special character</li>
                    </ul>

                    <label class="field-label">Confirm Password <span class="required">*Required</span></label>
                    <div class="input-group">
                        <i class="fa-solid fa-lock"></i>
                        <input type="password" name="ConfirmPassword" id="confirmField" placeholder="Confirm password" required />
                        <i class="fa-solid fa-eye toggle-eye" onclick="toggleField('confirmField')"></i>
                    </div>
                    <p id="confirmError" class="field-error" style="display:none;">Passwords do not match</p>

                    <button type="submit" class="btn-register">Register Account</button>
                </form>

                <p class="login-text">
                    Already have an account? <a asp-controller="Account" asp-action="Login">Log in</a>
                </p>
            }
        </div>

        <div class="register-right">
            <div class="right-content">
                <div class="right-brand">
                    <h3>SMART STAY</h3>
                    <p>YOUR TRUSTED RENTAL PARTNER</p>
                </div>
                <div class="right-features">
                    <p>Easy property listing</p>
                    <p>24/7 customer support</p>
                    <p>Instant help seamless renting</p>
                </div>
            </div>
        </div>
    </div>

    <script>
        function toggleField(id) {
            const field = document.getElementById(id);
            field.type = field.type === 'password' ? 'text' : 'password';
        }

        function toggleRoleFields() {
            const role = document.querySelector('input[name="Role"]:checked').value;
            document.getElementById('tenantFields').style.display = role === 'Tenant' ? 'block' : 'none';
            document.getElementById('landlordFields').style.display = role === 'Landlord' ? 'block' : 'none';
        }

        document.querySelectorAll('input[name="Role"]').forEach(function (radio) {
            radio.addEventListener('change', toggleRoleFields);
        });

        document.addEventListener('DOMContentLoaded', toggleRoleFields);

        // Password requirement checklist
        const pwdField = document.getElementById('passwordField');
        const rules = {
            ruleLength: pwd => pwd.length >= 8,
            ruleUpper: pwd => /[A-Z]/.test(pwd),
            ruleNumber: pwd => /\d/.test(pwd),
            ruleSpecial: pwd => /[!@@#$%^&*(),.?":{}|<>]/.test(pwd)
        };

        pwdField.addEventListener('input', function () {
            const value = pwdField.value;
            for (const [id, check] of Object.entries(rules)) {
                const el = document.getElementById(id);
                el.classList.toggle('valid', check(value));
            }
        });

        // Confirm password match check
        const confirmField = document.getElementById('confirmField');
        const confirmError = document.getElementById('confirmError');

        function checkPasswordsMatch() {
            const match = pwdField.value === confirmField.value;
            confirmError.style.display = (confirmField.value.length > 0 && !match) ? 'block' : 'none';
            return match;
        }

        confirmField.addEventListener('input', checkPasswordsMatch);
        pwdField.addEventListener('input', checkPasswordsMatch);

        document.querySelector('form').addEventListener('submit', function (e) {
            if (!checkPasswordsMatch()) {
                e.preventDefault();
            }
        });
    </script>

</body>
</html>