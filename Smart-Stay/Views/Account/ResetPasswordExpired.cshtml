@{
    ViewData["Title"] = "Reset Session Expired";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Smart Stay - Session Expired</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f5f7ff;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
        }

        .box {
            background: white;
            padding: 35px;
            border-radius: 15px;
            text-align: center;
            width: 90%;
            max-width: 420px;
            box-shadow: 0 4px 20px #00000015;
        }

        h2 {
            color: #4868ff;
        }

        a {
            display: inline-block;
            margin-top: 15px;
            padding: 13px 22px;
            border-radius: 25px;
            background: #4868ff;
            color: white;
            text-decoration: none;
        }
    </style>
</head>
<body>
    <div class="box">
        <h2>Session Expired</h2>

        <p>Your verification code or password reset session has expired.</p>
        <p>Please start the password recovery process again.</p>

        <a asp-controller="Account"
           asp-action="ForgotPassword">
            Start Again
        </a>
    </div>
</body>
</html>
