@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Smart Stay - Forgot Password</title>
    <link rel="stylesheet" href="~/css/login.css" />

    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f5f7ff;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
        }

        .reset-box {
            background: white;
            padding: 32px;
            border-radius: 15px;
            width: 90%;
            max-width: 440px;
            box-shadow: 0 4px 20px #00000015;
        }

        h2 {
            color: #4868ff;
        }

        input {
            width: 100%;
            padding: 14px;
            margin: 12px 0 20px;
            box-sizing: border-box;
            border: 1px solid #ccc;
            border-radius: 7px;
        }

        button {
            width: 100%;
            padding: 15px;
            background: #4868ff;
            color: white;
            border: none;
            border-radius: 25px;
            cursor: pointer;
            font-size: 16px;
        }

        .message {
            color: #333;
        }

        a {
            display: block;
            text-align: center;
            margin-top: 22px;
            color: #0087c9;
            text-decoration: none;
        }
    </style>
</head>
<body>
    <div class="reset-box">
        <h2>Forgot Password?</h2>

        <p>Enter your email address to receive a verification code.</p>

        @if (TempData["Message"] != null)
        {
            <p class="message">@TempData["Message"]</p>
        }

        <form asp-controller="Account"
              asp-action="ForgotPassword"
              method="post">

            @Html.AntiForgeryToken()

            <label for="email">Email address</label>

            <input type="email"
                   id="email"
                   name="email"
                   placeholder="Enter your email"
                   autocomplete="email"
                   required />

            <button type="submit">Send Verification Code</button>
        </form>

        <a asp-controller="Account" asp-action="Login">
            Back to Login
        </a>
    </div>
</body>
</html>
