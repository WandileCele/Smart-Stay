@model List<Smart_Stay.Models.PropertyCardViewModel>

@{
    ViewData["Title"] = "All Properties";
}

@section Styles {

    <style>

        /* =========================================================
                   PAGE
                ========================================================= */

        .browse-page {
            padding: 35px 45px 60px;
            max-width: 1500px;
            margin: auto;
        }


        /* =========================================================
                   HEADER
                ========================================================= */

        .browse-header {
            text-align: center;
            margin-bottom: 35px;
        }

            .browse-header h1 {
                font-size: 32px;
                font-weight: 700;
                margin-bottom: 8px;
            }

            .browse-header p {
                color: #777;
                font-size: 16px;
            }


        /* =========================================================
                   BACK BUTTON
                ========================================================= */

        .pd-buttons {
            margin-bottom: 20px;
        }

        .pd-cta-outline {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 10px 18px;
            border: 1px solid #0087c9;
            border-radius: 8px;
            color: #0087c9;
            background: white;
            font-weight: 600;
            font-size: 14px;
            text-decoration: none;
            transition: 0.2s;
        }

            .pd-cta-outline:hover {
                background: #0087c9;
                color: white;
            }


        /* =========================================================
                   SEARCH AREA
                ========================================================= */

        .property-search {
            display: flex;
            gap: 15px;
            align-items: center;
            margin-bottom: 40px;
            padding: 20px;
            background: #ffffff;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.08);
        }


        .search-input {
            flex: 1;
            display: flex;
            border: 1px solid #ddd;
            border-radius: 10px;
            overflow: hidden;
            background: white;
        }

            .search-input input {
                flex: 1;
                border: none;
                outline: none;
                padding: 13px 16px;
                font-size: 15px;
            }

            .search-input button {
                border: none;
                background: #0087c9;
                color: white;
                padding: 0 20px;
                cursor: pointer;
                font-size: 17px;
            }


        .property-search select {
            padding: 13px 15px;
            border: 1px solid #ddd;
            border-radius: 10px;
            background: white;
            min-width: 180px;
            outline: none;
            cursor: pointer;
        }


        .filter-button {
            padding: 13px 25px;
            border: none;
            border-radius: 10px;
            background: #0087c9;
            color: white;
            font-weight: 600;
            cursor: pointer;
            transition: 0.2s;
        }

            .filter-button:hover {
                background: #006fa6;
            }


        /* =========================================================
                   SAME PROPERTY GRID AS HOME PAGE
                ========================================================= */

        .cards {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 30px;
        }


        /* =========================================================
                   SAME PROPERTY LINK AS HOME PAGE
                ========================================================= */

        .property-link {
            text-decoration: none;
            color: inherit;
            display: block;
        }


        /* =========================================================
                   SAME PROPERTY CARD AS HOME PAGE
                ========================================================= */

        .card {
            background: white;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 5px 18px rgba(0,0,0,0.08);
            transition: transform 0.25s ease, box-shadow 0.25s ease;
            height: 100%;
        }


            .card:hover {
                transform: translateY(-6px);
                box-shadow: 0 10px 25px rgba(0,0,0,0.14);
            }


            /* =========================================================
                   IMAGE
                ========================================================= */

            .card img {
                width: 100%;
                height: 220px;
                object-fit: cover;
                display: block;
            }


        .no-image {
            width: 100%;
            height: 220px;
            background: #eef3f5;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 50px;
            color: #aaa;
        }


        /* =========================================================
                   CARD CONTENT
                ========================================================= */

        .card h3 {
            font-size: 21px;
            font-weight: 700;
            margin: 20px 20px 12px;
            color: #222;
        }


        .card p {
            margin: 8px 20px;
            color: #777;
            font-size: 14px;
        }


            .card p i {
                margin-right: 6px;
            }


        #money {
            color: #0087c9;
            font-size: 19px;
            font-weight: 700;
            margin-top: 15px;
        }


        /* =========================================================
                   RATING
                ========================================================= */

        .rating {
            display: flex;
            align-items: center;
            gap: 3px;
            margin: 15px 20px 20px;
            min-height: 24px;
        }


            .rating i {
                font-size: 17px;
            }


            .rating span {
                margin-left: 7px;
                font-size: 13px;
                color: #777;
            }


        .no-rating {
            color: #999 !important;
            margin-left: 0 !important;
        }


        /* =========================================================
                   NO RESULTS
                ========================================================= */

        .no-results {
            text-align: center;
            padding: 70px 20px;
        }


            .no-results h2 {
                font-size: 25px;
                margin-bottom: 10px;
            }


            .no-results p {
                color: #777;
            }


        /* =========================================================
                   RESPONSIVE
                ========================================================= */

        @@media (max-width: 1100px) {

            .cards {
                grid-template-columns: repeat(2, 1fr);
            }

            .property-search {
                flex-wrap: wrap;
            }

            .search-input {
                width: 100%;
                flex: none;
            }
        }


        @@media (max-width: 700px) {

            .browse-page {
                padding: 25px 20px;
            }

            .cards {
                grid-template-columns: 1fr;
            }

            .property-search {
                flex-direction: column;
                align-items: stretch;
            }

                .property-search select {
                    width: 100%;
                }

            .filter-button {
                width: 100%;
            }

            .browse-header h1 {
                font-size: 26px;
            }
        }

    </style>
}


<div class="browse-page">


    <!-- =========================================================
         BACK BUTTON
    ========================================================= -->

    <div class="pd-buttons">

        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            if (User.IsInRole("Landlord"))
            {
                <a asp-controller="Landlord"
                   asp-action="Dashboard"
                   class="pd-cta-outline">

                    &laquo; Back to Dashboard

                </a>
            }
            else if (User.IsInRole("Admin"))
            {
                <a asp-controller="Admin"
                   asp-action="Dashboard"
                   class="pd-cta-outline">

                    &laquo; Back to Dashboard

                </a>
            }
            else if (User.IsInRole("Tenant"))
            {
                <a asp-controller="Tenant"
                   asp-action="Dashboard"
                   class="pd-cta-outline">

                    &laquo; Back to Dashboard

                </a>
            }
        }
        else
        {
            <a asp-controller="Home"
               asp-action="Index"
               class="pd-cta-outline">

                &laquo; Back to Home

            </a>
        }

    </div>



    <!-- =========================================================
         HEADER
    ========================================================= -->

    <div class="browse-header">

        <h1>
            Find Your Perfect Accommodation 🏠
        </h1>

        <p>
            Browse available properties and find a place
            that feels like home.
        </p>

    </div>



    <!-- =========================================================
         SEARCH + FILTERS
    ========================================================= -->

    <form asp-controller="Properties"
          asp-action="viewAll"
          method="get"
          class="property-search">


        <!-- SEARCH -->

        <div class="search-input">

            <input type="text"
                   name="search"
                   value="@ViewBag.Search"
                   placeholder="Search property or location..." />

            <button type="submit">
                🔍
            </button>

        </div>



        <!-- LOCATION -->

        <select name="location">

            <option value="">
                Filter by location
            </option>

            <option value="Walmer"
                    selected="@(ViewBag.Location == "Walmer")">
                Walmer
            </option>

            <option value="Humewood"
                    selected="@(ViewBag.Location == "Humewood")">
                Humewood
            </option>

            <option value="Summerstrand"
                    selected="@(ViewBag.Location == "Summerstrand")">
                Summerstrand
            </option>

            <option value="North End"
                    selected="@(ViewBag.Location == "North End")">
                North End
            </option>

            <option value="Newton Park"
                    selected="@(ViewBag.Location == "Newton Park")">
                Newton Park
            </option>

            <option value="Central"
                    selected="@(ViewBag.Location == "Central")">
                Central
            </option>

        </select>



        <!-- PRICE -->

        <select name="price">

            <option value="">
                Filter by price
            </option>

            <option value="0-2000"
                    selected="@(ViewBag.Price == "0-2000")">
                R0 - R2 000
            </option>

            <option value="2000-3000"
                    selected="@(ViewBag.Price == "2000-3000")">
                R2 000 - R3 000
            </option>

            <option value="3000-5000"
                    selected="@(ViewBag.Price == "3000-5000")">
                R3 000 - R5 000
            </option>

            <option value="5000+"
                    selected="@(ViewBag.Price == "5000+")">
                R5 000+
            </option>

        </select>

        <!-- SEARCH BUTTON -->

        <button type="submit"
                class="filter-button">

            Search

        </button>

    </form>



    <!-- =========================================================
         PROPERTY CARDS
         SAME STRUCTURE AS HOME PAGE
    ========================================================= -->
    @if (Model != null && Model.Any())
    {

        <div class="cards">

            @foreach (var item in Model)
            {

                <a class="property-link"
                   asp-controller="Properties"
                   asp-action="Details"
                   asp-route-id="@item.PropertyID"
                   asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString">


                    <div class="card">


                        <!-- IMAGE -->
                        @if (!string.IsNullOrEmpty(item.ImagePath))
                        {
                            <img src="@item.ImagePath"
                                 alt="@item.Title" />
                        }
                        else
                        {
                            <div class="no-image">
                                🏠
                            </div>
                        }



                        <!-- TITLE -->

                        <h3>
                            @item.Title
                        </h3>



                        <!-- BEDROOMS -->

                        <p>

                            <i class="fa-solid fa-bed"></i>

                            @item.Bedrooms Bedrooms

                        </p>



                        <!-- BATHROOMS -->

                        <p>

                            <i class="fa-solid fa-bath"></i>

                            @item.Bathrooms Bathrooms

                        </p>



                        <!-- LOCATION -->

                        <p>

                            <i class="fa-solid fa-location-dot"></i>

                            @item.Location

                        </p>



                        <!-- PRICE -->

                        <p id="money">

                            <i class="fa-solid fa-money-bill"></i>

                            R @item.Price.ToString("N2") / PM

                        </p>



                        <!-- RATING -->

                        <div class="rating">

                            @if (item.AverageRating.HasValue)
                            {

                                var fullStars =
                                (int)Math.Floor(
                                item.AverageRating.Value
                                );

                                var hasHalfStar =
                                item.AverageRating.Value - fullStars >= 0.5;


                                @for (int i = 1; i <= 5; i++)
                                {

                                    if (i <= fullStars)
                                    {
                                        <i class="fa-solid fa-star"></i>
                                    }
                                    else if (i == fullStars + 1 && hasHalfStar)
                                    {
                                        <i class="fa-solid fa-star-half-stroke"></i>
                                    }
                                    else
                                    {
                                        <i class="fa-regular fa-star"></i>
                                    }

                                }


                                <span>

                                    @item.AverageRating.Value.ToString("0.0")
                                    (@item.ReviewCount)

                                </span>

                            }
                            else
                            {

                                <span class="no-rating">

                                    ☆ No ratings yet

                                </span>

                            }

                        </div>


                    </div>

                </a>

            }

        </div>

    }
    else
    {

        <!-- =====================================================
             NO RESULTS
        ====================================================== -->

        <div class="no-results">

            <h2>
                No accommodations found 😕
            </h2>

            <p>
                Try changing your search or filters.
            </p>

        </div>

    }


</div>