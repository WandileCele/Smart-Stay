@model Smart_Stay.Models.PropertyCreateViewModel
@{
    ViewData["Title"] = "Add Property";
}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<link rel="stylesheet" href="~/css/Property.css" asp-append-version="true" />

<div class="container-fluid px-lg-5 mt-4">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <strong>Success!</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <a href="@Url.Action("Dashboard", "Landlord")" class="back-button">
        <i class="bi bi-arrow-left"></i> Back to Dashboard
    </a>

    <div class="mb-4">
        <h2 class="fw-bold text-primary">Add New Property</h2>
        <p class="text-muted">Complete the information below to list your property.</p>
    </div>

    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <div class="row g-5">

           
            <div class="col-lg-7">

                <div class="form-section">
                    <h5>Basic Info</h5>
                    <div class="mb-3">
                        <label asp-for="Title"></label>
                        <input asp-for="Title" class="form-control form-control-lg" placeholder="Enter property title" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description"></label>
                        <textarea asp-for="Description" rows="5" class="form-control" placeholder="Describe your property"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="PropertyType"></label>
                            <select asp-for="PropertyType" class="form-select">
                                <option value="">Select Property Type</option>
                                <option>Apartment</option>
                                <option>House</option>
                                <option>Flat</option>
                                <option>Room</option>
                                <option>Student Accommodation</option>
                            </select>
                            <span asp-validation-for="PropertyType" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Location"></label>
                            <select asp-for="Location" id="Location" class="form-select">
                                <option value="">Select Area</option>
                                <option value="Walmer">Walmer</option>
                                <option value="North End">North End</option>
                                <option value="Humewood">Humewood</option>
                                <option value="Summerstrand">Summerstrand</option>
                                <option value="Newton Park">Newton Park</option>
                                <option value="Central">Central</option>
                            </select>
                            <span asp-validation-for="Location" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="form-section">
                    <h5>Pricing & Size</h5>
                    <div class="mb-3">
                        <label asp-for="Price"></label>
                        <div class="input-group">
                            <span class="input-group-text">R</span>
                            <input asp-for="Price" type="number" class="form-control" placeholder="0.00" min="0" step="0.01" />
                            <select name="pricePeriod" class="form-select" style="max-width:150px;">
                                <option>per night</option>
                                <option>per week</option>
                                <option selected>per month</option>
                            </select>
                        </div>
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Bedrooms"></label>
                            <input asp-for="Bedrooms" type="number" class="form-control" min="0" />
                            <span asp-validation-for="Bedrooms" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Bathrooms"></label>
                            <input asp-for="Bathrooms" type="number" class="form-control" min="0" />
                            <span asp-validation-for="Bathrooms" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="form-section">
                    <div class="mb-4">
                        <div class="label-row">
                            <label asp-for="PropertyImages">📷 Property Images</label>
                            <span class="required">*Required (min 3)</span>
                        </div>
                        <div class="upload-box" id="imagesBox">
                            <input asp-for="PropertyImages" type="file" multiple accept=".jpg,.jpeg,.png" id="imagesInput" />
                            <div class="upload-content">
                                <div class="upload-icon">↑</div>
                                <div id="imagesUploadText">Click to upload or drag and drop</div>
                                <small>JPG or PNG — at least 3 images</small>
                            </div>
                        </div>
                        <span asp-validation-for="PropertyImages" class="text-danger"></span>
                    </div>

                    <div>
                        <div class="label-row">
                            <label asp-for="Affidavit">📄 Affidavit</label>
                            <span class="required">*Required</span>
                        </div>
                        <div class="upload-box" id="affidavitBox">
                            <input asp-for="Affidavit" type="file" accept=".pdf" id="affidavitInput" />
                            <div class="upload-content">
                                <div class="upload-icon">↑</div>
                                <div id="affidavitUploadText">Click to upload or drag and drop</div>
                                <small>PDF up to 3MB</small>
                            </div>
                        </div>
                        <span asp-validation-for="Affidavit" class="text-danger"></span>
                    </div>
                </div>

                <div class="pb-5 mb-4">
                    <button type="submit" class="btn btn-primary btn-lg w-100 mt-4 py-3">
                        Add Property
                    </button>
                </div>
            </div>

            <!-- RIGHT: Map -->
            <div class="col-lg-5">
                <div class="map-wrapper">
                    <div class="form-section p-0">
                        <div class="p-3">
                            <label class="fw-bold">Pin Your Property's Location</label>
                            <div style="position:relative;">
                                <input type="text" id="address-search" class="form-control mb-2" autocomplete="off" placeholder="Search an address, or drag the pin on the map below" />
                                <div id="address-suggestions" class="list-group" style="position:absolute; z-index:1000; width:100%; display:none; max-height:220px; overflow-y:auto;"></div>
                            </div>
                        </div>

                        <div id="property-map" style="height:550px;"></div>

                        <div class="p-3">
                            <label asp-for="Address"></label>
                            <input asp-for="Address" id="Address" class="form-control" readonly placeholder="Drag the pin to auto-fill address" />
                            <span asp-validation-for="Address" class="text-danger"></span>

                            <small id="address-manual-note" class="text-muted" style="display:none;">
                                We couldn't recognize this location — please type it manually.
                            </small>

                            <small id="area-warning" class="text-primary d-block mt-2">
                                <strong>Notice:</strong> Your map location will be reviewed. If incorrect, your application may be rejected.
                            </small>

                            <input asp-for="Latitude" type="hidden" id="Latitude" />
                            <input asp-for="Longitude" type="hidden" id="Longitude" />
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </form>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        
        setTimeout(() => {
            const alert = document.querySelector(".alert");
            if (alert) {
                const bsAlert = bootstrap.Alert.getOrCreateInstance(alert);
                bsAlert.close();
            }
        }, 4000);

        
        function setupUploadBox(boxId, inputId, textId) {
            const box = document.getElementById(boxId);
            const input = document.getElementById(inputId);
            const text = document.getElementById(textId);
            if (!box ||!input ||!text) return;

            const defaultText = text.textContent;

            function updateText() {
                if (input.files && input.files.length > 0) {
                    box.classList.add("has-files");
                    if (input.files.length === 1) {
                        text.textContent = input.files[0].name;
                    } else {
                        text.textContent = `${input.files.length} files selected`;
                    }
                } else {
                    box.classList.remove("has-files");
                    text.textContent = defaultText;
                }
            }

            input.addEventListener("change", updateText);

            box.addEventListener("dragover", (e) => {
                e.preventDefault();
                box.classList.add("dragover");
            });

            box.addEventListener("dragleave", () => {
                box.classList.remove("dragover");
            });

            box.addEventListener("drop", (e) => {
                e.preventDefault();
                box.classList.remove("dragover");
                if (e.dataTransfer.files.length > 0) {
                    input.files = e.dataTransfer.files;
                    updateText();
                }
            });
        }

        setupUploadBox("imagesBox", "imagesInput", "imagesUploadText");
        setupUploadBox("affidavitBox", "affidavitInput", "affidavitUploadText");

       
        const ALLOWED_AREAS = {
            "walmer": "Walmer",
            "north end": "North End",
            "humewood": "Humewood",
            "summerstrand": "Summerstrand",
            "newton park": "Newton Park",
            "central": "Central"
        };

        const DEFAULT_CENTER = [-33.9608, 25.6022];
        let map, marker, searchTimer;

        function initPropertyMap() {
            map = L.map("property-map").setView(DEFAULT_CENTER, 12);

            L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
                maxZoom: 19,
                attribution: "&copy; OpenStreetMap contributors"
            }).addTo(map);

            marker = L.marker(DEFAULT_CENTER, { draggable: true }).addTo(map);

            marker.on("dragend", () => {
                const pos = marker.getLatLng();
                reverseGeocode(pos.lat, pos.lng);
            });

            map.on("click", (e) => {
                marker.setLatLng(e.latlng);
                reverseGeocode(e.latlng.lat, e.latlng.lng);
            });

            setupAddressSearch();
        }

        function setupAddressSearch() {
            const input = document.getElementById("address-search");
            const suggestionsBox = document.getElementById("address-suggestions");

            input.addEventListener("input", () => {
                const query = input.value.trim();
                clearTimeout(searchTimer);

                if (query.length < 3) {
                    suggestionsBox.style.display = "none";
                    return;
                }

                searchTimer = setTimeout(() => {
                    searchAddress(query, suggestionsBox);
                }, 500);
            });

            document.addEventListener("click", (e) => {
                if (e.target!== input) {
                    suggestionsBox.style.display = "none";
                }
            });
        }

        function searchAddress(query, suggestionsBox) {
            const url = `https://nominatim.openstreetmap.org/search?format=jsonv2&addressdetails=1&limit=5&countrycodes=za&q=${encodeURIComponent(query)}`;

            fetch(url, { headers: { "Accept-Language": "en" } })
               .then(res => res.json())
               .then(results => {
                    suggestionsBox.innerHTML = "";

                    if (!results || results.length === 0) {
                        suggestionsBox.style.display = "none";
                        return;
                    }

                    results.forEach(place => {
                        const item = document.createElement("button");
                        item.type = "button";
                        item.className = "list-group-item list-group-item-action";
                        item.textContent = place.display_name;

                        item.addEventListener("click", () => {
                            const lat = parseFloat(place.lat);
                            const lon = parseFloat(place.lon);

                            document.getElementById("address-search").value = place.display_name;
                            suggestionsBox.style.display = "none";

                            map.setView([lat, lon], 16);
                            marker.setLatLng([lat, lon]);

                            applyRecognizedResult(lat, lon, place);
                        });

                        suggestionsBox.appendChild(item);
                    });

                    suggestionsBox.style.display = "block";
                });
        }

        function reverseGeocode(lat, lng) {
            document.getElementById("Latitude").value = lat;
            document.getElementById("Longitude").value = lng;

            const url = `https://nominatim.openstreetmap.org/reverse?format=jsonv2&addressdetails=1&lat=${lat}&lon=${lng}`;

            fetch(url, { headers: { "Accept-Language": "en" } })
               .then(res => res.json())
               .then(result => {
                    if (result && result.address &&!result.error) {
                        applyRecognizedResult(lat, lng, result);
                    } else {
                        applyUnrecognizedResult(lat, lng);
                    }
                })
               .catch(() => {
                    applyUnrecognizedResult(lat, lng);
                });
        }

        function applyRecognizedResult(lat, lng, place) {
            document.getElementById("Latitude").value = lat;
            document.getElementById("Longitude").value = lng;

            const addressInput = document.getElementById("Address");
            const manualNote = document.getElementById("address-manual-note");

            addressInput.value = place.display_name;
            addressInput.readOnly = true;
            manualNote.style.display = "none";

            const matchedArea = matchAreaFromAddress(place.address || {});
            const dropdown = document.getElementById("Location");

            if (matchedArea) {
                dropdown.value = matchedArea;
            }
        }

        function applyUnrecognizedResult(lat, lng) {
            const addressInput = document.getElementById("Address");
            const manualNote = document.getElementById("address-manual-note");

            addressInput.readOnly = false;
            addressInput.value = "";
            addressInput.placeholder = "Type the address for this location";
            manualNote.style.display = "block";
            addressInput.focus();
        }

        function matchAreaFromAddress(address) {
            const keys = ["suburb", "neighbourhood", "city_district", "quarter", "town", "village"];

            for (const key of keys) {
                const value = address[key];
                if (value && ALLOWED_AREAS[value.toLowerCase()]) {
                    return ALLOWED_AREAS[value.toLowerCase()];
                }
            }

            const allText = Object.values(address).join(" ").toLowerCase();
            for (const areaKey in ALLOWED_AREAS) {
                if (allText.includes(areaKey)) {
                    return ALLOWED_AREAS[areaKey];
                }
            }

            return null;
        }

        
        initPropertyMap();
    </script>
}