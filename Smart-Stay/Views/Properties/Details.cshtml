@model Smart_Stay.Models.PropertyDetailsViewModel
@{
    var tag = System.Text.RegularExpressions.Regex.Match(Model.Property.Description ?? "", @"\[PricePeriod:(.+?)\]");
    var period = tag.Success ? tag.Groups[1].Value : "per month";
    var cleanDescription = System.Text.RegularExpressions.Regex.Replace(Model.Property.Description ?? "", @"\s*\[PricePeriod:.+?\]", "");
    ViewData["Title"] = "Property Details";
}
@section Styles {
    <link rel="stylesheet" href="~/css/PropertyDetails.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
}
<div class="pd-bg">
<div class="pd-page">

    <a href="@Model.ReturnUrl" class="pd-back">
        <span class="pd-back-arrow">←</span> Back
    </a>

    <div class="pd-top">

        <!-- LEFT: gallery -->
        <div class="pd-gallery">
            @if (Model.ImagePaths.Any())
            {
                <div class="pd-stage">
                    <img id="pdImage" class="pd-image" src="@Model.ImagePaths[0]" alt="@Model.Property.Title" />

                    @if (Model.ImagePaths.Count > 1)
                    {
                        <button type="button" id="pdPrev" class="pd-arrow pd-arrow-left" aria-label="Previous photo">&#10094;</button>
                        <button type="button" id="pdNext" class="pd-arrow pd-arrow-right" aria-label="Next photo">&#10095;</button>
                        <span id="pdCounter" class="pd-counter">1 / @Model.ImagePaths.Count</span>
                    }
                </div>

                @if (Model.ImagePaths.Count > 1)
                {
                    <div class="pd-thumbs">
                        @for (int i = 0; i < Model.ImagePaths.Count; i++)
                        {
                            <button type="button" class="pd-thumb @(i == 0 ? "active" : "")" data-index="@i">
                                <img src="@Model.ImagePaths[i]" alt="Photo @(i + 1)" />
                            </button>
                        }
                    </div>
                }
            }
            else
            {
                <div class="pd-noimg">No images available</div>
            }
        </div>

        <!-- RIGHT: summary card -->
        <aside class="pd-summary">
            <div class="pd-summary-card">

                <span class="pd-status pd-status-@((Model.Property.Status ?? "").ToLower())">@Model.Property.Status</span>

                <h1 class="pd-title">@Model.Property.Title</h1>
                <p class="pd-sub">@Model.Property.Location · @Model.Property.PropertyType</p>

                <div class="pd-price-row">
                    <span class="pd-price">R @Model.Property.Price.ToString("0.##")</span>
                    <span class="pd-period">@period</span>
                </div>

                <div class="pd-stats">
                    <div class="pd-stat">
                        <strong>@Model.Property.Bedrooms</strong>
                        <span>Bedrooms</span>
                    </div>
                    <div class="pd-stat">
                        <strong>@Model.Property.Bathrooms</strong>
                        <span>Bathrooms</span>
                    </div>
                   
                </div>

                @if (Model.Property.Latitude != null && Model.Property.Longitude != null)
                {
                    <button type="button" id="pdViewMapBtn" class="pd-view-map-btn">
                        <i class="bi bi-map-fill"></i> View On Map
                    </button>
                }

                @{
                    var currentRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
                    var loggedIn = User.Identity != null && User.Identity.IsAuthenticated;
                    var notTenant = loggedIn && currentRole != "Tenant";
                }

                <div class="pd-buttons">
                    @if (notTenant)
                    {
                        <a asp-controller="Account" asp-action="Login" class="pd-cta">Apply</a>
                    }
                    else if (Model.CanApply)
                    {
                        <a asp-controller="RentalApplications" asp-action="Apply" asp-route-propertyId="@Model.Property.PropertyId" class="pd-cta">Apply</a>
                    }
                    else
                    {
                        <span class="pd-cta pd-cta-disabled" title="@Model.ApplyBlockedReason">@Model.ApplyBlockedReason</span>
                    }

                    <a href="@Model.ReturnUrl" class="pd-cta-outline">Back</a>
                </div>

            </div>
        </aside>
    </div>

    <!-- DESCRIPTION + ADDRESS -->
    <section class="pd-card">
        <h2 class="pd-section-title">About this property</h2>
        <p class="pd-description">@cleanDescription</p>

        @if (!string.IsNullOrWhiteSpace(Model.Property.Address))
        {
            <div class="pd-address">
                <strong>Address</strong>
                <span>@Model.Property.Address</span>
            </div>
        }
    </section>

    <!-- REVIEWS -->
    <section class="pd-card pd-reviews">
        <h2 class="pd-section-title">Reviews (@Model.Property.Reviews.Count)</h2>

        @if (Model.Property.Reviews.Any())
        {
            <div class="pd-reviews-list">
                @foreach (var review in Model.Property.Reviews.OrderByDescending(r => r.ReviewDate))
                {
                    <div class="pd-review-item">
                        <div class="pd-review-header">
                            <span class="pd-review-rating">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <span class="@(i <= review.Rating ? "pd-star-filled" : "pd-star-empty")">&#9733;</span>
                                }
                            </span>
                            <span class="pd-review-date">@review.ReviewDate.ToString("dd MMM yyyy")</span>
                        </div>
                        <p class="pd-review-comment">@review.Comment</p>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="pd-no-reviews">No reviews yet for this property.</p>
        }
    </section>

</div>
<</div>

@if (Model.Property.Latitude != null && Model.Property.Longitude != null)
{
    <div id="pdMapModalOverlay" class="pd-map-modal-overlay">
        <div class="pd-map-modal">
            <div class="pd-map-modal-header">
                <strong>@Model.Property.Title</strong>
                <button type="button" id="pdMapModalClose" class="pd-map-modal-close">&times;</button>
            </div>
            <div id="pdMap"></div>
        </div>
    </div>
}
@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>

                const pdImages = @Html.Raw(Json.Serialize(Model.ImagePaths));
        let pdIndex = 0;

        const pdImgEl = document.getElementById("pdImage");
        const pdCounterEl = document.getElementById("pdCounter");
        const pdThumbs = document.querySelectorAll(".pd-thumb");

        function pdRender() {
            if (!pdImgEl) return;
            pdImgEl.src = pdImages[pdIndex];

            if (pdCounterEl) {
                pdCounterEl.textContent = `${pdIndex + 1} / ${pdImages.length}`;
            }

            pdThumbs.forEach((t, i) => t.classList.toggle("active", i === pdIndex));
        }

        document.getElementById("pdPrev")?.addEventListener("click", () => {
            pdIndex = (pdIndex - 1 + pdImages.length) % pdImages.length;
            pdRender();
        });

        document.getElementById("pdNext")?.addEventListener("click", () => {
            pdIndex = (pdIndex + 1) % pdImages.length;
            pdRender();
        });

        pdThumbs.forEach(t => t.addEventListener("click", () => {
            pdIndex = parseInt(t.dataset.index, 10);
            pdRender();
        }));

        
        @if (Model.Property.Latitude != null && Model.Property.Longitude != null)
        {
                <text>
                const pdLat = @Model.Property.Latitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
                const pdLng = @Model.Property.Longitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
                const pdAddress = @Html.Raw(Json.Serialize(Model.Property.Address ?? Model.Property.Location));

                let pdMap = null;

                function pdOpenMapModal() {
                    document.getElementById("pdMapModalOverlay").classList.add("active");

                    if (!pdMap) {
                        pdMap = L.map("pdMap").setView([pdLat, pdLng], 16);

                        L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
                            maxZoom: 19,
                            attribution: "&copy; OpenStreetMap contributors"
                        }).addTo(pdMap);

                        L.marker([pdLat, pdLng])
                           .addTo(pdMap)
                           .bindPopup(pdAddress)
                           .openPopup();
                    } else {
                        setTimeout(() => pdMap.invalidateSize(), 100);
                    }
                }

                function pdCloseMapModal() {
                    document.getElementById("pdMapModalOverlay").classList.remove("active");
                }

                document.getElementById("pdViewMapBtn")?.addEventListener("click", pdOpenMapModal);
                document.getElementById("pdMapModalClose")?.addEventListener("click", pdCloseMapModal);

                document.getElementById("pdMapModalOverlay")?.addEventListener("click", function (e) {
                    if (e.target === this) {
                        pdCloseMapModal();
                    }
                });
                </text>
        }
    </script>
}