
@model Smart_Stay.Models.PropertyStatusViewModel

@{
    ViewData["Title"] = "Update Property Status";
}

@section Styles {
    <link rel="stylesheet" href="~/css/UpdateStatus.css" asp-append-version="true" />
}

<div class="status-page">

    <div class="status-card">

        <div class="status-header">
            <div class="status-icon">
                <i class="fa-solid fa-building"></i>
            </div>

            <div>
                <h1>Update Property Status</h1>
                <p>Manage the availability of your property.</p>
            </div>
        </div>

        <div class="property-name">
            <span>Property</span>
            <h2>@Model.PropertyTitle</h2>
        </div>

        <form asp-action="UpdateStatus" method="post">

            <input type="hidden" asp-for="PropertyId" />

            <div class="form-group">
                <label asp-for="Status">Property Status</label>

                <select asp-for="Status" class="status-select" id="Status">
                    <option value="Available">Available</option>
                    <option value="Occupied">Occupied</option>
                    <option value="Maintenance">Maintenance</option>
                </select>
            </div>

            <div class="status-explanation" id="status-explanation">

                <div class="explanation-icon">
                    <i class="fa-solid fa-circle-info"></i>
                </div>

                <div>
                    <h3 id="status-explanation-title"></h3>
                    <p id="status-explanation-text"></p>
                </div>

            </div>

            <div class="status-actions">

                <a asp-controller="Landlord"
                   asp-action="Dashboard"
                   class="btn-cancel">
                    Cancel
                </a>

                <button type="submit" class="btn-save">
                    <i class="fa-solid fa-check"></i>
                    Save Status
                </button>

            </div>

        </form>

    </div>

</div>

<script>

    const statusSelect = document.getElementById("Status");
    const statusExplanation = document.getElementById("status-explanation");
    const statusTitle = document.getElementById("status-explanation-title");
    const statusText = document.getElementById("status-explanation-text");

    function updateStatusExplanation() {

        switch (statusSelect.value) {

            case "Available":

                statusTitle.textContent = "Available";
                statusText.textContent =
                    "The property is available for tenants and will be displayed on the home page.";

                break;

            case "Occupied":

                statusTitle.textContent = "Occupied";
                statusText.textContent =
                    "The property is currently full or occupied and will not be displayed on the home page.";

                break;

            case "Maintenance":

                statusTitle.textContent = "Maintenance";
                statusText.textContent =
                    "The property is currently under maintenance and will not be displayed on the home page.";

                break;
        }
    }

    statusSelect.addEventListener("change", updateStatusExplanation);

    updateStatusExplanation();

</script>
