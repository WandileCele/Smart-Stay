@model Smart_Stay.Models.RentalApplicationFormViewModel

@{
    ViewData["Title"] = "Apply for Rental";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/RentalApplication.css"
          asp-append-version="true" />
}

<div class="rental-page">

    <div class="form-card">

        <h1>APPLY FOR RENTAL</h1>

        <p class="property-name">
            Property:
            <strong>@Model.PropertyTitle</strong>
        </p>

        <div asp-validation-summary="ModelOnly" class="validation"></div>

        <form asp-action="Apply"
              asp-controller="RentalApplications"
              method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="PropertyId" />


            <!-- FIRST NAME -->
            <div class="form-group">
                <div class="label-row">
                    <label asp-for="FirstName">First Name</label>
                    <span class="required">*Required</span>
                </div>

                <input asp-for="FirstName"
                       class="form-input"
                       placeholder="Enter your first name"
                       autocomplete="given-name"
                       id="firstName" />

                <span asp-validation-for="FirstName" class="validation"></span>
            </div>


            <!-- LAST NAME -->
            <div class="form-group">
                <div class="label-row">
                    <label asp-for="LastName">Last Name</label>
                    <span class="required">*Required</span>
                </div>

                <input asp-for="LastName"
                       class="form-input"
                       placeholder="Enter your last name"
                       autocomplete="family-name"
                       id="lastName" />

                <span asp-validation-for="LastName" class="validation"></span>
            </div>


            <!-- ID NUMBER -->
            <div class="form-group">
                <div class="label-row">
                    <label asp-for="IdNumber">ID Number</label>
                    <span class="required">*Required</span>
                </div>

                <input asp-for="IdNumber"
                       class="form-input"
                       placeholder="Enter your 13-digit ID number"
                       maxlength="13"
                       inputmode="numeric"
                       autocomplete="off"
                       id="idNumber" />

                <span class="validation" asp-validation-for="IdNumber"></span>
            </div>


            <!-- PHONE NUMBER -->
            <div class="form-group">
                <div class="label-row">
                    <label asp-for="PhoneNumber">Phone number</label>
                    <span class="required">*Required</span>
                </div>

                <input asp-for="PhoneNumber"
                       class="form-input"
                       placeholder="e.g. 0786739991"
                       maxlength="10"
                       inputmode="numeric"
                       autocomplete="tel"
                       id="phoneNumber" />

                <span asp-validation-for="PhoneNumber" class="validation"></span>
            </div>


            <!-- EMAIL -->
            <div class="form-group">
                <div class="label-row">
                    <label asp-for="Email">Email address</label>
                    <span class="required">*Required</span>
                </div>

                <input asp-for="Email"
                       type="email"
                       class="form-input"
                       placeholder="e.g. example@gmail.com"
                       autocomplete="email" />

                <span asp-validation-for="Email" class="validation"></span>
            </div>


            <!-- EMPLOYMENT -->
            <div class="form-group">
                <div class="label-row">
                    <label asp-for="Employment">Employment</label>
                    <span class="required">*Required</span>
                </div>

                <input asp-for="Employment"
                       class="form-input"
                       placeholder="e.g. Data analyst" />

                <span asp-validation-for="Employment" class="validation"></span>
            </div>
            <!-- LEASE START DATE -->
            <div class="form-group">
                <div class="label-row">
                    <label asp-for="LeaseStartDate">Lease start date</label>
                    <span class="required">*Required</span>
                </div>

                <input asp-for="LeaseStartDate"
                       type="date"
                       class="form-input"
                       min="@DateTime.Now.ToString("yyyy-MM-dd")"
                       id="leaseStartDate" />

                <span asp-validation-for="LeaseStartDate" class="validation"></span>
            </div>


            <!-- LEASE END DATE -->
            <div class="form-group">
                <div class="label-row">
                    <label asp-for="LeaseEndDate">Lease end date</label>
                    <span class="required">*Required</span>
                </div>

                <input asp-for="LeaseEndDate"
                       type="date"
                       class="form-input"
                       min="@DateTime.Now.ToString("yyyy-MM-dd")"
                       id="leaseEndDate" />

                <span asp-validation-for="LeaseEndDate" class="validation"></span>
            </div>


            <!-- PAYSLIP -->
            <div class="form-group payslip-group">
                <div class="label-row">
                    <label asp-for="Payslip">Upload payslip</label>
                    <span class="required">*Required</span>
                </div>

                <div class="upload-box">
                    <input asp-for="Payslip"
                           type="file"
                           accept=".pdf,application/pdf"
                           id="payslipInput" />

                    <div class="upload-content">
                        <div class="upload-icon">&uarr;</div>
                        <div id="uploadText">Click to upload or drag and drop</div>
                        <small>PDF document up to 3MB</small>
                    </div>
                </div>

                <span asp-validation-for="Payslip" class="validation"></span>
            </div>


            <!-- TERMS -->
            <div class="terms">
                <input asp-for="AcceptTerms" type="checkbox" id="acceptTerms" />
                <label asp-for="AcceptTerms">Accept T's &amp; C's</label>
            </div>
            <span asp-validation-for="AcceptTerms" class="validation"></span>


            <!-- BUTTONS -->
            <div class="buttons">
                <button type="submit" class="submit-button">
                    Submit Application
                </button>

                <button type="reset" class="cancel-button">
                    Cancel
                </button>
            </div>

        </form>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        // ==========================================
        // ID NUMBER - NUMBERS ONLY (cosmetic, does not block submit)
        // ==========================================
        const idNumber = document.getElementById("idNumber");
        idNumber.addEventListener("input", function () {
            this.value = this.value.replace(/\D/g, '').slice(0, 13);
        });


        // ==========================================
        // PHONE NUMBER - NUMBERS ONLY (cosmetic, does not block submit)
        // ==========================================
        const phoneNumber = document.getElementById("phoneNumber");
        phoneNumber.addEventListener("input", function () {
            this.value = this.value.replace(/\D/g, '').slice(0, 10);
        });


        // ==========================================
        // NAMES - LETTERS ONLY (cosmetic, does not block submit)
        // ==========================================
        const firstName = document.getElementById("firstName");
        const lastName = document.getElementById("lastName");

        firstName.addEventListener("input", function () {
            this.value = this.value.replace(/[^A-Za-z\s'-]/g, '');
        });

        lastName.addEventListener("input", function () {
            this.value = this.value.replace(/[^A-Za-z\s'-]/g, '');
        });


        // ==========================================
        // PAYSLIP PREVIEW
        // This only clears an invalid file choice; it never touches
        // form submission and has no event.preventDefault() on submit.
        // ==========================================
        const payslipInput = document.getElementById("payslipInput");
        const uploadText = document.getElementById("uploadText");

        payslipInput.addEventListener("change", function () {
            if (this.files.length > 0) {
                const file = this.files[0];

                if (file.type !== "application/pdf" &&
                    !file.name.toLowerCase().endsWith(".pdf")) {
                    alert("Please upload a PDF payslip.");
                    this.value = "";
                    uploadText.textContent = "Click to upload or drag and drop";
                    return;
                }

                if (file.size > 3 * 1024 * 1024) {
                    alert("Payslip must be 3MB or smaller.");
                    this.value = "";
                    uploadText.textContent = "Click to upload or drag and drop";
                    return;
                }

                uploadText.textContent = file.name;
            }
        });

                // ==========================================
        // LEASE END DATE - CANNOT BE BEFORE START DATE
        // ==========================================
        const leaseStartDate = document.getElementById("leaseStartDate");
        const leaseEndDate = document.getElementById("leaseEndDate");

        leaseStartDate.addEventListener("change", function () {
            leaseEndDate.min = this.value;
        });
 

    </script>
}

