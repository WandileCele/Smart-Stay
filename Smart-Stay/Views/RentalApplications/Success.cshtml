@{
    ViewData["Title"] = "Application Submitted";
}
@section Styles {
    <link rel="stylesheet"
          href="~/css/Success.css"
          asp-append-version="true" />
}



<div class="rental-page">

    <div class="success-card">

        <div class="success-icon">
            <i class="bi bi-check-circle-fill"></i>
        </div>

        <h1 class="success-title">Application Submitted!</h1>

        <p class="success-message">
            Your rental application (ID: <strong>@ViewBag.ApplicationId</strong>)
            has been received and saved successfully.
        </p>

        <div class="success-actions">

            <a class="submit-button"
               target="_blank"
               href="@Url.Action("DownloadPdf", "RentalApplications", new { id = ViewBag.ApplicationId })">
                <i class="bi bi-download"></i>
                Download Confirmation PDF
            </a>

        </div>

        <a class="success-return-link" href="@Url.Action("Index", "Home")">
            <i class="bi bi-arrow-left"></i>
            Return to Home
        </a>

    </div>

</div>
