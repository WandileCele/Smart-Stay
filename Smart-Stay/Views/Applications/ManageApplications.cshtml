@model List<Smart_Stay.Models.ApplicationReviewViewModel>

@{
    ViewData["Title"] = "Manage Applications";
    var currentStatus = ViewBag.CurrentStatus as string ?? "Pending";
}

@section Styles {
    <link rel="stylesheet" href="~/css/ManageApplications.css" asp-append-version="true" />
}

<div class="applications-page">
    <button type="button" class="back-button" onclick="history.back()">
        <span aria-hidden="true">←</span> Back
    </button>
    <h1>APPLICATIONS</h1>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="status-filter">
        <a asp-action="ManageApplications" asp-route-status="Pending" class="@(currentStatus == "Pending" ? "active" : "")">Pending</a>
        <a asp-action="ManageApplications" asp-route-status="Approved" class="@(currentStatus == "Approved" ? "active" : "")">Approved</a>
        <a asp-action="ManageApplications" asp-route-status="Rejected" class="@(currentStatus == "Rejected" ? "active" : "")">Rejected</a>
        <a asp-action="ManageApplications" asp-route-status="All" class="@(currentStatus == "All" ? "active" : "")">All</a>
    </div>

    @if (!Model.Any())
    {
        <p class="no-applications">No applications found.</p>
    }

    @foreach (var app in Model)
    {
        <div class="application-card">

            <div class="app-header">
                <span class="tenant-name">
                    <span class="icon icon-user">👤</span> @app.TenantName
                </span>
                <span class="applied-date">Applied: @app.ApplicationDate.ToString("yyyy-MM-dd")</span>
            </div>

            <p class="contact-line"><span class="icon icon-mail">✉️</span> @app.Email</p>
            <p class="contact-line"><span class="icon icon-phone">📞</span> @app.PhoneNumber</p>

            <div class="app-details">
                <div>
                    <strong>Employment</strong>
                    <div>@app.Employment</div>
                </div>
                <div>
                    <strong>Proof of Income</strong>
                    @if (app.PayslipPath != null)
                    {
                        <a href="@app.PayslipPath" target="_blank" class="payslip-link">📄 View Payslip</a>
                    }
                    else
                    {
                        <span class="not-uploaded">Not uploaded</span>
                    }
                </div>
            </div>

            <p class="property-tag">Property: <strong>@app.PropertyTitle</strong></p>

            @if (app.Status != "Rejected" && app.LeaseStartDate.HasValue && app.LeaseEndDate.HasValue)
            {
                <p class="property-tag">
                    Lease: <strong>@app.LeaseStartDate.Value.ToString("yyyy-MM-dd")</strong>
                    to
                    <strong>@app.LeaseEndDate.Value.ToString("yyyy-MM-dd")</strong>
                </p>
            }

            @if (app.Status == "Pending")
            {
                <div class="action-buttons">

                    <form asp-action="Approve" asp-route-id="@app.RentalApplicationId" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-approve">Approve</button>
                    </form>

                    <form asp-action="Reject" asp-route-id="@app.RentalApplicationId" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-reject">Reject</button>
                    </form>

                    <button type="button"
                            class="btn-info"
                            data-bs-toggle="modal"
                            data-bs-target="#infoModal-@app.RentalApplicationId">
                        Request more info
                    </button>

                </div>
            }
            else
            {
                <span class="status-badge status-@app.Status.ToLower()">@app.Status</span>
            }

        </div>

        <!-- REQUEST MORE INFO MODAL -->
        <div class="modal fade" id="infoModal-@app.RentalApplicationId" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">

                    <form asp-action="RequestMoreInfo" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@app.RentalApplicationId" />

                        <div class="modal-header">
                            <h5 class="modal-title">Request more info from @app.TenantName</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>

                        <div class="modal-body">
                            <textarea name="message"
                                  class="form-control"
                                  rows="4"
                                  placeholder="e.g. Please provide your latest 3 months of bank statements..."
                                  required></textarea>
                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-warning">Send</button>
                        </div>

                    </form>

                </div>
            </div>
        </div>
    }

</div>