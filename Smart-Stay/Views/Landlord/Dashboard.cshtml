
@using System.Linq
@model Smart_Stay.Models.LandlordDashboardViewModel

@{
    ViewData["Title"] = "Landlord Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="~/css/LanlordDashboard.css" asp-append-version="true" />

    <style>
        .top-bar {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 14px;
        }

        .profile-pic-circle {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid #ffffff;
        }

        .profile-pic-fallback {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #e9ecef;
            color: #0d6efd;
            font-size: 22px;
            border: 2px solid #0d6efd;
        }

        /* ================================================
                   PROPERTY TOOLBAR
                   ================================================ */

        .property-toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
            margin-bottom: 20px;
        }

        .property-filter {
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .property-filter label {
                font-weight: 600;
                white-space: nowrap;
                margin: 0;
            }

            .property-filter select {
                width: 260px;
                min-width: 260px;
            }

        /* ================================================
                   LOADER
                   ================================================ */

        .global-loader {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(255, 255, 255, 0.85);
            z-index: 9999;
            align-items: center;
            justify-content: center;
        }

            .global-loader.active {
                display: flex;
            }

        .loader-box {
            text-align: center;
        }

        .house-loader {
            position: relative;
            width: 90px;
            height: 90px;
            margin: 0 auto 15px;
        }

            .house-loader svg {
                width: 100%;
                height: 100%;
            }

        .house-outline {
            stroke: #0087c9;
            stroke-width: 3;
            fill: none;
            stroke-linecap: round;
            stroke-linejoin: round;
            stroke-dasharray: 220;
            stroke-dashoffset: 220;
            animation: draw-house 2.2s ease-in-out infinite;
        }

        .house-key {
            transform-origin: 50px 55px;
            animation: turn-key 2.2s ease-in-out infinite;
        }

            .house-key circle {
                fill: none;
                stroke: #0d6efd;
                stroke-width: 3;
            }

            .house-key line {
                stroke: #0d6efd;
                stroke-width: 3;
                stroke-linecap: round;
            }

        @@keyframes draw-house {
            0% {
                stroke-dashoffset: 220;
                opacity: 0.3;
            }

            50% {
                stroke-dashoffset: 0;
                opacity: 1;
            }

            100% {
                stroke-dashoffset: 0;
                opacity: 0.3;
            }
        }

        @@keyframes turn-key {
            0%, 20% {
                transform: rotate(0deg);
            }

            40% {
                transform: rotate(-25deg);
            }

            60% {
                transform: rotate(15deg);
            }

            80%, 100% {
                transform: rotate(0deg);
            }
        }

        #logout-loader-text {
            font-size: 15px;
            color: #333;
            font-weight: 600;
            min-height: 20px;
            transition: opacity 0.25s ease;
        }

        /* ================================================
                   MOBILE
                   ================================================ */

        @@media (max-width: 768px) {

            .property-toolbar {
                flex-direction: column;
                align-items: stretch;
                gap: 15px;
            }

            .property-filter {
                width: 100%;
            }

                .property-filter select {
                    width: 100%;
                    min-width: 0;
                }
        }
    </style>
}

<div class="dashboard">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">

            <strong>Success!</strong> @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    <div class="sidebar-container">

        <button class="menu-toggle" onclick="toggleMenu()">
            ☰
        </button>

        <div class="sidebar" id="sidebar">

            <h3>Landlord Menu</h3>

            <a href="#properties">
                <i class="bi bi-house-gear-fill"></i>
                Update Property
            </a>

            <a asp-controller="Applications"
               asp-action="ManageApplications">
                📄 Manage Applications
            </a>

            <a asp-controller="Landlord"
               asp-action="UpdateProfile">
                <i class="bi bi-person-circle"></i>
                Update Profile
            </a>

            <a asp-controller="Home"
               asp-action="Index">
                🏠 Home
            </a>

        </div>

    </div>

    <div class="top-bar">

        <a asp-controller="Landlord"
           asp-action="UpdateProfile"
           title="Update Profile">

            @if (!string.IsNullOrWhiteSpace(Model.ProfileImagePath))
            {
                <img src="@Model.ProfileImagePath"
                     alt="Profile picture"
                     class="profile-pic-circle" />
            }
            else
            {
                <div class="profile-pic-fallback">
                    <i class="bi bi-person-fill"></i>
                </div>
            }

        </a>

        <form asp-controller="Account"
              asp-action="Logout"
              method="post"
              id="logoutForm">

            <button type="submit" class="logout-btn">

                <i class="bi bi-box-arrow-right"></i>
                Logout

            </button>

        </form>

    </div>

    <div class="dashboard-header">

        <h2>Welcome back, @Model.FirstName 🏡!</h2>

        <div class="statistics">

            <div class="stat-card">

                <h3>@Model.TotalProperties</h3>
                <p>Total Properties</p>

            </div>

            <div class="stat-card">

                <h3>@Model.TotalApplications</h3>
                <p>Total Applications</p>

            </div>

            <div class="stat-card">

                <h3>@Model.AvailableProperties</h3>
                <p>Available Properties</p>

            </div>

        </div>

    </div>

    <!-- ================================================
         ADD PROPERTY + PROPERTY FILTER
         ================================================ -->

    <div class="property-toolbar">

        <a asp-controller="Properties"
           asp-action="Create"
           class="btn add-property-btn">
            <i class="bi bi-plus-circle"></i>
            Add Property
        </a>

        <div class="property-filter">

            <label for="propertyFilter">

                <i class="bi bi-funnel-fill"></i>
                Filter Property

            </label>

            <select id="propertyFilter"
                    class="form-select">

                <option value="all">
                    All Properties
                </option>

                @foreach (var property in Model.Properties)
                {
                    <option value="property-@property.PropertyID">
                        @property.Title
                    </option>
                }

            </select>

        </div>

    </div>

    <hr />

    <div id="properties" class="property-container">

        @foreach (var property in Model.Properties)
        {


            <div class="property-card"
                 id="property-@property.PropertyID">

                <h3>@property.Title</h3>

                <!-- PROPERTY DETAILS -->

                <p class="property-detail">

                    <i class="bi bi-map-fill"></i>

                    <strong>Address:</strong>

                    <span>
                        @ShortenAddress(property.Address)
                    </span>

                </p>

                <p class="property-detail">

                    <i class="bi bi-geo-alt-fill"></i>

                    <strong>Location:</strong>

                    <span>
                        @property.Location
                    </span>

                </p>

                <p class="property-detail">

                    <i class="bi bi-house-door-fill"></i>

                    <strong>Bedrooms:</strong>

                    <span>
                        @property.Bedrooms
                    </span>

                </p>

                <p class="property-detail">

                    <i class="bi bi-droplet-fill"></i>

                    <strong>Bathrooms:</strong>

                    <span>
                        @property.Bathrooms
                    </span>

                </p>

                <p class="property-detail">
                    <i class="bi bi-cash-stack"></i>
                    <strong>Price:</strong>
                    <span>
                        R @property.Price.ToString("0.##") @property.PricePeriod
                    </span>
                </p>

                <p class="property-detail">

                    <i class="bi bi-arrow-repeat"></i>

                    <strong>Status:</strong>

                    <span>
                        @property.Status
                    </span>

                </p>

                <p class="property-detail">

                    <i class="bi bi-file-earmark-text-fill"></i>

                    <strong>Applications:</strong>

                    <span>
                        @property.ApplicationCount
                    </span>

                </p>

                <div class="card-buttons">

                    <a asp-controller="Properties"
                       asp-action="Details"
                       asp-route-id="@property.PropertyID"
                       asp-route-returnUrl="@Url.Action("Dashboard", "Landlord")"
                       class="btn btn-info">

                        View

                    </a>

                    <a asp-controller="Properties"
                       asp-action="Edit"
                       asp-route-id="@property.PropertyID"
                       class="btn btn-primary">

                        Update Property

                    </a>

                    <form asp-controller="Properties"
                          asp-action="Delete"
                          asp-route-id="@property.PropertyID"
                          method="post"
                          class="delete-form"
                          onsubmit="return confirm('Are you sure you want to delete this property?');">

                        <button type="submit"
                                class="delete-btn"
                                title="Delete Property">

                            <i class="bi bi-trash3"></i>

                        </button>

                    </form>

                    @if (property.Status == "Approved" ||
                                    property.Status == "Available" ||
                                    property.Status == "Occupied" ||
                                    property.Status == "Under Maintenance")
                    {
                        <form asp-controller="Properties"
                              asp-action="UpdateStatus"
                              asp-route-id="@property.PropertyID"
                              method="get">

                            <button type="submit"
                                    class="btn btn-status">

                                Update Status

                            </button>

                        </form>
                    }
                    else if (property.Status == "Pending")
                    {
                        <button class="btn btn-warning" disabled>

                           Pending Approval

                        </button>
                    }
                    else if (property.Status == "Rejected")
                    {
                        <button class="btn btn-danger" disabled>

                            Rejected

                        </button>
                    }

                </div>

            </div>
        }

    </div>

</div>

<!-- ================================================
     LOGOUT LOADER
     ================================================ -->

<div id="logout-loader" class="global-loader">

    <div class="loader-box">

        <div class="house-loader">

            <svg viewBox="0 0 100 100"
                 xmlns="http://www.w3.org/2000/svg">

                <!-- House outline -->

                <path class="house-outline"
                      d="M15 50 L50 20 L85 50 L85 85 L15 85 Z M35 85 L35 60 L65 60 L65 85" />

                <!-- Key -->

                <g class="house-key">

                    <circle cx="45"
                            cy="55"
                            r="6" />

                    <line x1="51"
                          y1="55"
                          x2="65"
                          y2="55" />

                    <line x1="60"
                          y1="55"
                          x2="60"
                          y2="61" />

                    <line x1="65"
                          y1="55"
                          x2="65"
                          y2="61" />

                </g>

            </svg>

        </div>

        <p id="logout-loader-text">
            Locking up your listings...
        </p>

    </div>

</div>

@functions {

    string ShortenAddress(string? address)
    {
        if (string.IsNullOrWhiteSpace(address))
            return "";

        var parts = address.Split(
            ',',
            System.StringSplitOptions.TrimEntries |
            System.StringSplitOptions.RemoveEmptyEntries);

        return string.Join(", ", parts.Take(2));
    }

}

@section Scripts {

    <script>

        // ================================================
        // SIDEBAR MENU
        // ================================================

        function toggleMenu()
        {
            var sidebar =
                document.getElementById("sidebar");

            sidebar.classList.toggle("show");
        }


        // ================================================
        // SUCCESS MESSAGE
        // ================================================

        setTimeout(function ()
        {
            var alert =
                document.querySelector(".alert");

            if (alert)
            {
                bootstrap.Alert
                    .getOrCreateInstance(alert)
                    .close();
            }

        }, 4000);


        // ================================================
        // PROPERTY FILTER
        // ================================================

        const propertyFilter =
            document.getElementById("propertyFilter");

        const propertyCards =
            document.querySelectorAll(".property-card");

        if (propertyFilter)
        {
            propertyFilter.addEventListener(
                "change",
                function ()
                {
                    const selectedProperty =
                        this.value;

                    propertyCards.forEach(
                        function (card)
                        {
                            if (selectedProperty === "all")
                            {
                                card.style.display = "";
                            }
                            else if (
                                card.id === selectedProperty)
                            {
                                card.style.display = "";
                            }
                            else
                            {
                                card.style.display = "none";
                            }
                        }
                    );
                }
            );
        }


        // ================================================
        // LOGOUT LOADER
        // ================================================

        (function ()
        {
            const form =
                document.getElementById("logoutForm");

            const loader =
                document.getElementById("logout-loader");

            const loaderText =
                document.getElementById("logout-loader-text");

            const landlordName =
                @Html.Raw(
                    System.Text.Json.JsonSerializer.Serialize(
                            Model.FirstName));

        const captions = [

            "Locking up your listings...",

            "Saving your property updates...",

            "Securing your dashboard...",

            "See you soon, " + landlordName + "!"

        ];

        let captionIndex = 0;

        form.addEventListener(
            "submit",
            function ()
            {
                loaderText.textContent =
                    captions[0];

                loader.classList.add("active");

                setInterval(
                    function ()
                    {
                        captionIndex =
                            (captionIndex + 1)
                            % captions.length;

                        loaderText.style.opacity = 0;

                        setTimeout(
                            function ()
                            {
                                loaderText.textContent =
                                    captions[captionIndex];

                                loaderText.style.opacity = 1;

                            },
                            200
                        );

                    },
                    1200
                );
            }
        );

    })();

</script>

}
