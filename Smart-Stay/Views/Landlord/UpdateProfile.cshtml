@model Smart_Stay.Models.UpdateProfileViewModel

@{
    ViewData["Title"] = "Update Profile";
}

@section Styles
{
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

    <link rel="stylesheet"
          href="~/css/update-profile.css"
          asp-append-version="true" />

    <style>

        .global-loader {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(255, 255, 255, 0.85);
            z-index: 9999;
            align-items: center;
            justify-content: center;
        }

            .global-loader.active {
                display: flex;
            }

        .loader-box {
            text-align: center;
        }

        .house-loader {
            position: relative;
            width: 90px;
            height: 90px;
            margin: 0 auto 15px;
        }

            .house-loader svg {
                width: 100%;
                height: 100%;
            }

        .house-outline {
            stroke: #0087c9;
            stroke-width: 3;
            fill: none;
            stroke-linecap: round;
            stroke-linejoin: round;
            stroke-dasharray: 220;
            stroke-dashoffset: 220;
            animation: draw-house 2.2s ease-in-out infinite;
        }

        .house-key {
            transform-origin: 50px 55px;
            animation: turn-key 2.2s ease-in-out infinite;
        }

            .house-key circle {
                fill: none;
                stroke: #0d6efd;
                stroke-width: 3;
            }

            .house-key line {
                stroke: #0d6efd;
                stroke-width: 3;
                stroke-linecap: round;
            }

        @@keyframes draw-house {
            0% {
                stroke-dashoffset: 220;
                opacity: 0.3;
            }

            50% {
                stroke-dashoffset: 0;
                opacity: 1;
            }

            100% {
                stroke-dashoffset: 0;
                opacity: 0.3;
            }
        }

        @@keyframes turn-key {
            0%, 20% {
                transform: rotate(0deg);
            }

            40% {
                transform: rotate(-25deg);
            }

            60% {
                transform: rotate(15deg);
            }

            80%, 100% {
                transform: rotate(0deg);
            }
        }

        #profile-loader-text {
            font-size: 15px;
            color: #333;
            font-weight: 600;
            min-height: 20px;
            transition: opacity 0.25s ease;
        }

    </style>
}


<div class="profile-page">

    <!-- =====================================================
         HEADER
    ====================================================== -->

    <div class="profile-header">

        <h1>UPDATE PROFILE</h1>

        <a asp-controller="Landlord"
           asp-action="Dashboard"
           class="back-button">

            <i class="bi bi-arrow-left"></i>

            Back

        </a>

    </div>



    <!-- =====================================================
         PROFILE CARD
    ====================================================== -->

    <div class="profile-card">


        <!-- =================================================
             SUCCESS MESSAGE
             Note: on a successful save the controller now
             redirects to Dashboard, so this banner will only
             appear here if TempData was set some other way
             (e.g. validation passed but you navigate back).
        ================================================== -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="success-message">

                @TempData["SuccessMessage"]

                <span>
                    ✓
                </span>

            </div>
        }


        <!-- =================================================
             FORM
        ================================================== -->

        <form asp-action="UpdateProfile"
              asp-controller="Landlord"
              method="post"
              enctype="multipart/form-data"
              id="updateProfileForm">


            @Html.AntiForgeryToken()


            <!-- =============================================
                 PROFILE IMAGE
            ============================================== -->

            <div class="profile-image-section">


                <div class="profile-image-container">


                    @if (!string.IsNullOrEmpty(
                                        Model.CurrentImagePath))
                    {
                        <img id="profilePreview"
                             src="@Model.CurrentImagePath"
                             alt="Profile Picture"
                             class="profile-image" />
                    }
                    else
                    {
                        <div id="defaultProfile"
                             class="default-profile">

                            <i class="bi bi-person"></i>

                        </div>

                        <img id="profilePreview"
                             class="profile-image hidden"
                             alt="Profile Picture" />
                    }


                    <label for="ProfileImage"
                           class="image-upload-overlay">

                        <i class="bi bi-camera"></i>

                    </label>


                </div>


                <label for="ProfileImage"
                       class="upload-photo-text">

                    Upload photo

                </label>


                <input asp-for="ProfileImage"
                       type="file"
                       id="ProfileImage"
                       accept=".jpg,.jpeg,.png,.gif"
                       class="image-input" />


                <span asp-validation-for="ProfileImage"
                      class="validation-error">
                </span>


            </div>



            <!-- =============================================
                 FIRST NAME
            ============================================== -->

            <div class="form-group">

                <label asp-for="FirstName">

                    First Name

                </label>


                <input asp-for="FirstName"
                       class="form-control" />


                <span asp-validation-for="FirstName"
                      class="validation-error">
                </span>

            </div>



            <!-- =============================================
                 LAST NAME
            ============================================== -->

            <div class="form-group">

                <label asp-for="SurName">

                    Last Name

                </label>


                <input asp-for="SurName"
                       class="form-control" />


                <span asp-validation-for="SurName"
                      class="validation-error">
                </span>

            </div>



            <!-- =============================================
                 EMAIL
            ============================================== -->

            <div class="form-group">

                <label asp-for="Email">

                    Email address

                </label>


                <input asp-for="Email"
                       type="email"
                       class="form-control" />


                <span asp-validation-for="Email"
                      class="validation-error">
                </span>

            </div>



            <!-- =============================================
                 PHONE
            ============================================== -->

            <div class="form-group">

                <label asp-for="PhoneNo">

                    Phone number

                </label>


                <input asp-for="PhoneNo"
                       maxlength="10"
                       class="form-control" />


                <span asp-validation-for="PhoneNo"
                      class="validation-error">
                </span>

            </div>



            <!-- =============================================
                 NEW PASSWORD
            ============================================== -->


            <div class="form-group">

                <label asp-for="NewPassword">
                    Change password
                </label>

                <div class="password-wrapper">

                    <input asp-for="NewPassword"
                           type="password"
                           id="NewPassword"
                           class="form-control password-input"
                           placeholder="Leave blank to keep current password" />

                    <button type="button"
                            class="toggle-password"
                            onclick="togglePassword('NewPassword', this)">

                        <i class="bi bi-eye"></i>

                    </button>

                </div>


                <div class="password-requirements">

                    <div id="lengthRequirement"
                         class="password-requirement invalid">

                        <i class="bi bi-x-circle-fill"></i>
                        <span>At least 8 characters</span>

                    </div>


                    <div id="uppercaseRequirement"
                         class="password-requirement invalid">

                        <i class="bi bi-x-circle-fill"></i>
                        <span>1 uppercase letter</span>

                    </div>


                    <div id="numberRequirement"
                         class="password-requirement invalid">

                        <i class="bi bi-x-circle-fill"></i>
                        <span>1 number</span>

                    </div>


                    <div id="specialRequirement"
                         class="password-requirement invalid">

                        <i class="bi bi-x-circle-fill"></i>
                        <span>1 special character</span>

                    </div>

                </div>


                <span asp-validation-for="NewPassword"
                      class="validation-error">
                </span>

            </div>


            <!-- =============================================
                 CONFIRM PASSWORD
            ============================================== -->

            <div class="form-group">

                <label asp-for="ConfirmPassword">

                    Confirm password

                </label>


                <div class="password-wrapper">

                    <input asp-for="ConfirmPassword"
                           type="password"
                           id="ConfirmPassword"
                           class="form-control password-input"
                           placeholder="Confirm new password" />


                    <button type="button"
                            class="toggle-password"
                            onclick="togglePassword('ConfirmPassword', this)">

                        <i class="bi bi-eye"></i>

                    </button>

                </div>


                <span asp-validation-for="ConfirmPassword"
                      class="validation-error">
                </span>

            </div>



            <!-- =============================================
                 BUTTONS
            ============================================== -->

            <div class="profile-buttons">


                <button type="submit"
                        class="submit-button">

                    Submit Changes

                </button>


                <a asp-controller="Landlord"
                   asp-action="Dashboard"
                   class="cancel-button">

                    Cancel

                </a>


            </div>


        </form>

    </div>

</div>

<div id="profile-loader" class="global-loader">
    <div class="loader-box">


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>

        // =================================================
        // PASSWORD EYE
        // =================================================

        function togglePassword(inputId, button) {

            var input =
                document.getElementById(inputId);

            var icon =
                button.querySelector("i");


            if (input.type === "password") {

                input.type = "text";

                icon.classList.remove("bi-eye");

                icon.classList.add("bi-eye-slash");

            }
            else {

                input.type = "password";

                icon.classList.remove("bi-eye-slash");

                icon.classList.add("bi-eye");

            }

        }


        // =================================================
        // PASSWORD VALIDATION
        // =================================================

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                var passwordInput =
                    document.getElementById(
                        "NewPassword"
                    );


                if (!passwordInput) {

                    return;

                }


                passwordInput.addEventListener(
                    "input",
                    function () {

                        var password =
                            passwordInput.value;


                        updateRequirement(
                            "lengthRequirement",
                            password.length >= 8
                        );


                        updateRequirement(
                            "uppercaseRequirement",
                            /[A-Z]/.test(password)
                        );


                        updateRequirement(
                            "numberRequirement",
                            /[0-9]/.test(password)
                        );


                        updateRequirement(
                            "specialRequirement",
                            /[^A-Za-z0-9]/.test(password)
                        );

                    }
                );

            }
        );


        // =================================================
        // UPDATE REQUIREMENT
        // =================================================

        function updateRequirement(
            requirementId,
            isValid) {

            var requirement =
                document.getElementById(
                    requirementId
                );


            if (!requirement) {

                return;

            }


            var icon =
                requirement.querySelector("i");


            if (isValid) {

                requirement.classList.remove(
                    "invalid"
                );

                requirement.classList.add(
                    "valid"
                );


                icon.classList.remove(
                    "bi-x-circle-fill"
                );

                icon.classList.add(
                    "bi-check-circle-fill"
                );

            }
            else {

                requirement.classList.remove(
                    "valid"
                );

                requirement.classList.add(
                    "invalid"
                );


                icon.classList.remove(
                    "bi-check-circle-fill"
                );

                icon.classList.add(
                    "bi-x-circle-fill"
                );

            }

        }


        // =================================================
        // IMAGE PREVIEW
        // =================================================

        var imageInput =
            document.getElementById(
                "ProfileImage"
            );


        if (imageInput) {

            imageInput.addEventListener(
                "change",
                function (event) {

                    var file =
                        event.target.files[0];


                    if (file) {

                        var reader =
                            new FileReader();


                        reader.onload =
                            function (e) {

                                var preview =
                                    document.getElementById(
                                        "profilePreview"
                                    );


                                var defaultProfile =
                                    document.getElementById(
                                        "defaultProfile"
                                    );


                                if (preview) {

                                    preview.src =
                                        e.target.result;

                                    preview.classList.remove(
                                        "hidden"
                                    );

                                }


                                if (defaultProfile) {

                                    defaultProfile.style.display =
                                        "none";

                                }

                            };


                        reader.readAsDataURL(
                            file
                        );

                    }

                }
            );

        }

    </script>
}
        <div class="house-loader">
            <svg viewBox="0 0 100 100"
