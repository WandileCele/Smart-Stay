<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Smart_Stay</title>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Smart_Stay.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/footer.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    @RenderSection("Styles", required: false)

    <style>
        .global-loader {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(255, 255, 255, 0.85);
            z-index: 9999;
            align-items: center;
            justify-content: center;
        }

            .global-loader.active {
                display: flex;
            }

        .loader-box {
            text-align: center;
        }

            .loader-box .spinner {
                width: 48px;
                height: 48px;
                border: 5px solid #ddd;
                border-top: 5px solid #0087c9;
                border-radius: 50%;
                margin: 0 auto 15px;
                animation: globalSpin 0.8s linear infinite;
            }

        @@keyframes globalSpin {
            to {
                transform: rotate(360deg);
            }
        }

        #loader-text {
            font-size: 15px;
            color: #333;
            font-weight: 600;
        }
    </style>
</head>
<body>


    <div class="container-fluid p-0">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-section">

        <div class="container">

            <div class="row gy-5">

                <!-- ================= LEFT ================= -->
                <div class="col-lg-3">

                    <div class="footer-logo">

                        <i class="bi bi-house-door"></i>

                        <div>
                            <h2>SMART STAY</h2>
                            <span>Find. Book. Stay Smart.</span>
                        </div>

                    </div>

                    <p class="footer-description">
                        Smart Stay connects students and visitors with trusted
                        accommodation across Port Elizabeth, making it easy
                        to find a place that feels like home.
                    </p>

                    <h4 class="footer-heading mt-5">
                        FOLLOW US
                    </h4>

                    <div class="social-icons">

                        <a href="#">
                            <i class="bi bi-facebook"></i>
                        </a>

                        <a href="#" class="instagram">
                            <i class="bi bi-instagram"></i>
                        </a>

                        <a href="#" class="linkedin">
                            <i class="bi bi-linkedin"></i>
                        </a>

                        <a href="#" class="twitter">
                            <i class="bi bi-twitter-x"></i>
                        </a>

                    </div>

                </div>

                <!-- ================= AREAS ================= -->

                <div class="col-lg-3">

                    <h3 class="footer-title">
                        AREAS IN PORT ELIZABETH
                    </h3>

                    <div class="title-line"></div>

                    <ul class="footer-list">

                        <li>
                            <i class="bi bi-geo-alt"></i>
                            <span>Walmer</span>
                        </li>

                        <li>
                            <i class="bi bi-geo-alt"></i>
                            <span>North End</span>
                        </li>

                        <li>
                            <i class="bi bi-geo-alt"></i>
                            <span>Humewood</span>
                        </li>

                        <li>
                            <i class="bi bi-geo-alt"></i>
                            <span>Summerstrand</span>
                        </li>

                        <li>
                            <i class="bi bi-geo-alt"></i>
                            <span>Newton Park</span>
                        </li>

                        <li>
                            <i class="bi bi-geo-alt"></i>
                            <span>Central</span>
                        </li>

                    </ul>

                </div>

                <!-- ================= QUICK LINKS ================= -->

                <div class="col-lg-3">

                    <h3 class="footer-title">
                        QUICK LINKS
                    </h3>

                    <div class="title-line"></div>

                    <ul class="footer-links">

                        <li>
                            <a asp-controller="Home" asp-action="Index">
                                <i class="bi bi-chevron-right"></i>
                                Home
                            </a>
                        </li>

                        <li>
                            <a asp-controller="Properties" asp-action="viewAll">
                                <i class="bi bi-chevron-right"></i>
                                Browse Properties
                            </a>
                        </li>

                        <li>
                            <a href="#">
                                <i class="bi bi-chevron-right"></i>
                                About Us
                            </a>
                        </li>

                        <li>
                            <a href="#">
                                <i class="bi bi-chevron-right"></i>
                                Contact Us
                            </a>
                        </li>

                        <li>
                            <a href="#">
                                <i class="bi bi-chevron-right"></i>
                                List Your Property
                            </a>
                        </li>

                    </ul>

                </div>

                <!-- ================= RIGHT ================= -->

                <div class="col-lg-3">

                    <h3 class="footer-title">
                        SUPPORT
                    </h3>

                    <div class="title-line"></div>

                    <ul class="footer-links">

                        <li>
                            <a href="#">
                                <i class="bi bi-chevron-right"></i>
                                How It Works
                            </a>
                        </li>

                        <li>
                            <a href="#">
                                <i class="bi bi-chevron-right"></i>
                                FAQs
                            </a>
                        </li>

                        <li>
                            <a href="#">
                                <i class="bi bi-chevron-right"></i>
                                Privacy Policy
                            </a>
                        </li>

                        <li>
                            <a href="#">
                                <i class="bi bi-chevron-right"></i>
                                Terms & Conditions
                            </a>
                        </li>

                        <li>
                            <a href="#">
                                <i class="bi bi-chevron-right"></i>
                                Support Center
                            </a>
                        </li>

                    </ul>

                    <div class="contact-section">

                        <h3 class="footer-title">
                            CONTACT US
                        </h3>

                        <div class="title-line"></div>

                        <div class="contact-item">
                            <i class="bi bi-telephone"></i>
                            <span>+27 41 000 0000</span>
                        </div>

                        <div class="contact-item">
                            <i class="bi bi-envelope"></i>
                            <span>support@smartstay.co.za</span>
                        </div>

                        <div class="contact-item">
                            <i class="bi bi-geo-alt"></i>
                            <span>Port Elizabeth, South Africa</span>
                        </div>

                    </div>

                </div>

            </div>

        </div>

        <div class="footer-bottom">

            <div class="container">

                <div class="bottom-content">

                    <div>
                        © 2026 Smart Stay. All Rights Reserved.
                    </div>

                    <div class="divider"></div>

                    <div>
                        <i class="bi bi-heart"></i>
                        Proudly made by <strong>Meta Minds</strong>
                    </div>

                </div>

            </div>

        </div>

    </footer>


    <!-- =========================================================
         GLOBAL LOADING OVERLAY
    ========================================================= -->

    <div id="global-loader" class="global-loader">
        <div class="loader-box">
            <div class="spinner"></div>
            <p id="loader-text">Loading...</p>
        </div>
    </div>


    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <!-- =====================================================
             SESSION TIMEOUT WARNING MODAL

             Shown after a period of inactivity. Counts down and
             auto-logs-out if the user doesn't respond.
        ====================================================== -->

        <div class="modal fade"
             id="sessionTimeoutModal"
             tabindex="-1"
             aria-hidden="true"
             data-bs-backdrop="static"
             data-bs-keyboard="false">

            <div class="modal-dialog modal-dialog-centered">

                <div class="modal-content">

                    <div class="modal-header">

                        <h5 class="modal-title">
                            <i class="bi bi-clock-history"></i>
                            Session Timing Out
                        </h5>

                    </div>

                    <div class="modal-body">

                        <p>
                            You've been inactive for a while.
                            For your security, you'll be logged
                            out in
                            <strong id="timeoutCountdown">60</strong>
                            seconds.
                        </p>

                    </div>

                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-primary"
                                id="staySignedInBtn">

                            Stay Signed In

                        </button>


                        <form asp-controller="Account"
                              asp-action="Logout"
                              method="post"
                              class="m-0">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-outline-secondary">

                                Log Out Now

                            </button>

                        </form>

                    </div>

                </div>

            </div>

        </div>


        <!-- Hidden form submitted automatically by JS when the
             countdown reaches zero -->

        <form id="autoLogoutForm"
              asp-controller="Account"
              asp-action="Logout"
              method="post"
              class="d-none">

            @Html.AntiForgeryToken()

        </form>
    }


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <script src="~/js/idle-timeout.js"
                asp-append-version="true"
                data-idle-minutes="14"
                data-warning-seconds="60"></script>
    }

    <script>
        (function () {
            const loader = document.getElementById("global-loader");
            const loaderText = document.getElementById("loader-text");
            let patienceTimer = null;

            function showLoader() {
                loaderText.textContent = "Loading...";
                loader.classList.add("active");

                patienceTimer = setTimeout(function () {
                    loaderText.textContent = "Please be patient...";
                }, 6000);
            }

            function hideLoader() {
                loader.classList.remove("active");
                clearTimeout(patienceTimer);
            }

            document.addEventListener("click", function (e) {
                const link = e.target.closest("a");
                if (!link) return;

                const href = link.getAttribute("href");
                if (!href || href.startsWith("#") || href.startsWith("javascript:")) return;
                if (link.target === "_blank") return;

                showLoader();
            });

            document.addEventListener("submit", function () {
                showLoader();
            });

            window.addEventListener("pageshow", hideLoader);
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>