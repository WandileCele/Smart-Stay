@model IEnumerable<Smart_Stay.Models.Landlord>

@{
    ViewData["Title"] = "Manage Landlords";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Manage Landlords</h2>
            <p class="text-muted">
                View and manage landlord accounts.
            </p>
        </div>

        <a asp-controller="Admin"
           asp-action="Dashboard"
           class="btn btn-secondary">
            Back to Dashboard
        </a>
    </div>


    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No landlord accounts found.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-bordered table-hover">

                <thead class="table-dark">
                    <tr>
                        <th>User ID</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Verification Status</th>
                        <th>Properties</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var landlord in Model)
                    {
                        <tr>

                            <td>
                                @landlord.UserId
                            </td>

                            <td>
                                @landlord.User.FirstName
                                @landlord.User.SurName
                            </td>

                            <td>
                                @landlord.User.Email
                            </td>

                            <td>
                                @landlord.User.PhoneNo
                            </td>

                            <td>
                                @if (landlord.VerificationStatus == "Approved")
                                {
                                    <span class="badge bg-success">
                                        Approved
                                    </span>
                                }
                                else if (landlord.VerificationStatus == "Rejected")
                                {
                                    <span class="badge bg-danger">
                                        Rejected
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        Pending
                                    </span>
                                }
                            </td>

                            <td>
                                @landlord.Properties.Count
                            </td>

                            <td>

                                <form asp-controller="Admin"
                                      asp-action="DeleteLandlord"
                                      method="post"
                                      onsubmit="return confirm('Are you sure you want to permanently delete this landlord account? All of their properties and related applications will also be deleted.');">

                                    <input type="hidden"
                                           name="id"
                                           value="@landlord.UserId" />

                                    <button type="submit"
                                            class="btn btn-danger btn-sm">
                                        Delete
                                    </button>

                                </form>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>