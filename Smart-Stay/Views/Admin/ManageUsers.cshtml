@model IEnumerable<Smart_Stay.Models.User>
@{
    ViewData["Title"] = "Manage Users";
}
@section Styles {
    <link rel="stylesheet" href="~/css/manageusers.css" asp-append-version="true" />
}
<div class="manage-users-page">
    <div class="page-header">
        <div><h2>Manage Users</h2><p>View and suspend user accounts.</p></div>
        <a asp-controller="Admin" asp-action="Dashboard" class="back-button">← Back to Dashboard</a>
    </div>
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="feedback-message feedback-success">✓ @TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="feedback-message feedback-error">✕ @TempData["ErrorMessage"]</div>
    }

    <div class="users-table-container">
        <div style="overflow-x:auto;">
            <table class="users-table">
                <thead><tr><th>User ID</th><th>Name</th><th>Email</th><th>Role</th><th>Action</th></tr></thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>@user.UserId</td>
                            <td>@user.FirstName @user.SurName</td>
                            <td>@user.Email</td>
                            <td>
                                <span class="role-badge role-@user.Role.ToLower()">@user.Role</span>
                                @if (user.IsSuspended)
                                {
                                    <span class="suspended-badge">Suspended</span>
                                }
                            </td>
                            <td>
                                <button type="button" class="action-button @(user.IsSuspended ? "unsuspend-button" : "suspend-button")"
                                        onclick="openConfirmation('@user.UserId','@user.FirstName @user.SurName','@user.Email', @user.IsSuspended.ToString().ToLower())">
                                    @(user.IsSuspended ? "Unsuspend" : "Suspend")
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div id="confirmationOverlay" class="confirmation-overlay" style="display:none;">
    <div class="confirmation-box">
        <form id="suspendForm" asp-controller="Admin" asp-action="SuspendUser" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="suspendUserId" />
            <div class="confirmation-header"><h4 id="confirmationTitle">Confirm Action</h4></div>
            <div class="confirmation-body">
                <p id="confirmationMessage"></p>
                <div id="reasonContainer" style="margin-top:12px;">
                    <label for="suspendReason"><b>Reason for suspension *</b></label>
                    <textarea id="suspendReason" name="reason" class="form-control" rows="4" required minlength="10" placeholder="e.g. Violation of listing policy, fake documents..."></textarea>
                    <small>Will be sent to user via email.</small>
                </div>
            </div>
            <div class="confirmation-footer">
                <button type="button" class="modal-cancel" onclick="closeConfirmation()">Cancel</button>
                <button type="submit" id="confirmActionButton" class="modal-confirm">Confirm</button>
            </div>
        </form>
    </div>
</div>

<script>
    function openConfirmation(userId, userName, userEmail, isSuspended) {
        document.getElementById('suspendUserId').value = userId;
        const overlay = document.getElementById("confirmationOverlay");
        const title = document.getElementById("confirmationTitle");
        const message = document.getElementById("confirmationMessage");
        const reasonBox = document.getElementById("reasonContainer");
        const confirmBtn = document.getElementById("confirmActionButton");
        const reasonInput = document.getElementById("suspendReason");

        if (isSuspended === true) {
            title.innerText = "Confirm Unsuspension";
            message.innerHTML = "Are you sure you want to unsuspend <span class='user-name-confirmation'>" + userName + "</span> ("+userEmail+")?";
            reasonBox.style.display = "none";
            reasonInput.required = false;
            confirmBtn.innerText = "Unsuspend";
            confirmBtn.className = "modal-confirm modal-confirm-unsuspend";
        } else {
            title.innerText = "Confirm Suspension";
            message.innerHTML = "Suspend <span class='user-name-confirmation'>" + userName + "</span>? The user will be emailed the reason.";
            reasonBox.style.display = "block";
            reasonInput.required = true;
            reasonInput.value = "";
            confirmBtn.innerText = "Suspend & Send Email";
            confirmBtn.className = "modal-confirm modal-confirm-suspend";
        }
        overlay.style.display = "flex";
    }
    function closeConfirmation() { document.getElementById("confirmationOverlay").style.display = "none"; }
    document.getElementById("confirmationOverlay").addEventListener("click", e => { if(e.target===e.currentTarget) closeConfirmation(); });
    document.addEventListener("keydown", e => { if(e.key==="Escape") closeConfirmation(); });
</script>