@using System.Text.RegularExpressions
@model Smart_Stay.Models.ListingApplicationReviewViewModel
@{
    ViewData["Title"] = "Application Details";
    var rawDesc = Model.Description ?? "";
    var tag = Regex.Match(rawDesc, @"\[PricePeriod:(.+?)\]");
    var pricePeriod = tag.Success ? tag.Groups[1].Value : "per month";
    var cleanDesc = Regex.Replace(rawDesc, @"\[PricePeriod:.*?\]", "").Trim();
}
@section Styles {
    <link rel="stylesheet" href="~/css/AdminSidebar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ReviewListing.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
}
<partial name="_AdminSidebar" />
<div class="review-container">
    <div class="review-header-row">
        <h2>Review Listing Application</h2>
        @if (Model.Latitude != null && Model.Longitude != null)
        {
            <button type="button" id="reviewViewMapBtn" class="review-view-map-btn">View On Map</button>
        }
    </div>
    <hr />
    <div class="property-details">
        <h3>@Model.Title</h3>
        <div class="detail-row"><span class="detail-label">Landlord:</span><span class="detail-value">@Model.LandlordName</span></div>
        <div class="detail-row"><span class="detail-label">Description:</span><span class="detail-value">@cleanDesc</span></div>
        @if (!string.IsNullOrWhiteSpace(Model.Address))
        {
            <div class="detail-row"><span class="detail-label">Address:</span><span class="detail-value">@Model.Address</span></div>
        }
        <div class="detail-row"><span class="detail-label">Location:</span><span class="detail-value">@Model.Location</span></div>
        <div class="detail-row"><span class="detail-label">Price:</span><span class="detail-value">R @Model.Price.ToString("N2") @pricePeriod</span></div>
        <div class="detail-row"><span class="detail-label">Property Type:</span><span class="detail-value">@Model.PropertyType</span></div>
        <div class="detail-row"><span class="detail-label">Bedrooms:</span><span class="detail-value">@(Model.Bedrooms?.ToString() ?? "N/A")</span></div>
        <div class="detail-row"><span class="detail-label">Bathrooms:</span><span class="detail-value">@(Model.Bathrooms?.ToString() ?? "N/A")</span></div>
        <div class="detail-row"><span class="detail-label">Application Date:</span><span class="detail-value">@Model.ApplicationDate.ToString("yyyy/MM/dd")</span></div>
        <div class="detail-row"><span class="detail-label">Status:</span><span class="detail-value"><span class="status-badge @Model.ApplicationStatus.ToLower()">@Model.ApplicationStatus</span></span></div>
    </div>
    <div class="affidavit-section">
        <h4>Affidavit</h4>
        @if (!string.IsNullOrEmpty(Model.AffidavitPath))
        {
            <a href="@Model.AffidavitPath" target="_blank" class="doc-link">View Affidavit</a>
        }
        else
        {

            <p>No affidavit uploaded.</p>
        }
    </div>
    <div class="images-section">
        <h4>Property Images</h4>
        @if (Model.ImagePaths != null && Model.ImagePaths.Any())
        {
            <div class="image-grid">
                @for (int i = 0; i < Model.ImagePaths.Count; i++)
                {
                    <img src="@Model.ImagePaths[i]" class="review-image-thumb" data-index="@i" alt="Property Image" />
                }
            </div>
        }
        else
        {

            <p>No images uploaded.</p>
        }
    </div>
    <div class="actions">
        <form asp-action="Approve" method="post" style="display:inline;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.ListingApplicationId" />
            <button type="submit" class="approve-btn">✔ Approve</button>
        </form>
        <button type="button" id="openRejectModalBtn" class="reject-btn">✖ Reject</button>
    </div>
</div>

<div id="rejectModalOverlay" class="reject-modal-overlay">
    <div class="reject-modal">
        <div class="reject-modal-header"><strong>Reject Application</strong><button type="button" id="rejectModalClose" class="reject-modal-close">&times;</button></div>
        <form asp-controller="Admin" asp-action="Reject" method="post" class="reject-modal-body">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.ListingApplicationId" />
            <label>Reason for rejection</label>
            <textarea name="reason" rows="4" required placeholder="Explain why this listing is being rejected — this will be emailed to the landlord."></textarea>
            <div class="reject-modal-actions">
                <button type="button" id="rejectModalCancel" class="reject-modal-cancel-btn">Cancel</button>
                <button type="submit" class="reject-modal-confirm-btn">Confirm Rejection</button>
            </div>
        </form>
    </div>
</div>

@if (Model.ImagePaths != null && Model.ImagePaths.Any())
{
    <div id="reviewLightboxOverlay" class="review-lightbox-overlay">
        <button type="button" id="reviewLightboxClose" class="review-lightbox-close">&times;</button>
        <button type="button" id="reviewLightboxPrev" class="review-lightbox-navbtn review-lightbox-prev">&laquo;</button>
        <img id="reviewLightboxImg" class="review-lightbox-img" src="" />
        <button type="button" id="reviewLightboxNext" class="review-lightbox-navbtn review-lightbox-next">&raquo;</button>
        <span id="reviewLightboxCounter" class="review-lightbox-counter"></span>
    </div>
}
@if (Model.Latitude != null && Model.Longitude != null)
{
    <div id="reviewMapModalOverlay" class="review-map-modal-overlay">
        <div class="review-map-modal"><div class="review-map-modal-header"><strong>@Model.Title</strong><button type="button" id="reviewMapModalClose" class="review-map-modal-close">&times;</button></div><div id="reviewMap"></div></div>
    </div>
}

@section Scripts {
    <script>
        const ro=document.getElementById("rejectModalOverlay");
        document.getElementById("openRejectModalBtn")?.addEventListener("click",()=>ro.classList.add("active"));
        document.getElementById("rejectModalClose")?.addEventListener("click",()=>ro.classList.remove("active"));
        document.getElementById("rejectModalCancel")?.addEventListener("click",()=>ro.classList.remove("active"));
        ro?.addEventListener("click",e=>{if(e.target===ro)ro.classList.remove("active");});
    </script>
    @if (Model.ImagePaths != null && Model.ImagePaths.Any())
    {
        <script>
            const imgs=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ImagePaths));let idx=0;
            const ov=document.getElementById("reviewLightboxOverlay"),im=document.getElementById("reviewLightboxImg"),ct=document.getElementById("reviewLightboxCounter");
            function render(){im.src=imgs[idx];ct.textContent=(idx+1)+" / "+imgs.length;}
            function openLb(i){idx=i;render();ov.classList.add("active");}
            document.querySelectorAll(".review-image-thumb").forEach(th=>th.addEventListener("click",function(){openLb(parseInt(this.dataset.index));}));
            document.getElementById("reviewLightboxClose")?.addEventListener("click",()=>ov.classList.remove("active"));
            document.getElementById("reviewLightboxPrev")?.addEventListener("click",()=>{idx=(idx-1+imgs.length)%imgs.length;render();});
            document.getElementById("reviewLightboxNext")?.addEventListener("click",()=>{idx=(idx+1)%imgs.length;render();});
            ov?.addEventListener("click",e=>{if(e.target===ov)ov.classList.remove("active");});
        </script>
    }
    @if (Model.Latitude != null && Model.Longitude != null)
    {
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
        <script>
            const lat=@Model.Latitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture),lng=@Model.Longitude.Value.ToString(System.Globalization.CultureInfo.InvariantCulture),addr=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Address ?? Model.Location));let map=null;
            function openMap(){document.getElementById("reviewMapModalOverlay").classList.add("active");if(!map){map=L.map("reviewMap").setView([lat,lng],16);L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",{maxZoom:19,attribution:"&copy; OSM"}).addTo(map);L.marker([lat,lng]).addTo(map).bindPopup(addr).openPopup();}else setTimeout(()=>map.invalidateSize(),100);}
            function closeMap(){document.getElementById("reviewMapModalOverlay").classList.remove("active");}
            document.getElementById("reviewViewMapBtn")?.addEventListener("click",openMap);
            document.getElementById("reviewMapModalClose")?.addEventListener("click",closeMap);
        </script>
    }
}
