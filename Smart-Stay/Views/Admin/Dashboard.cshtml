@model Smart_Stay.Models.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}
@section Styles {
    <link rel="stylesheet" href="~/css/AdminSidebar.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

    <style>
        .admin-dashboard {
            min-height: 100vh;
            padding:30px;
            background: linear-gradient(180deg, #2d7df7 0%, #1f5fc4 35%, #174a94 65%, #122E4D 100%);
        }
        /* BLUE BACKGROUND - LIKE TENANT DASHBOARD */
        body {
            background: linear-gradient( 180deg, #2d7df7 0%, #1f5fc4 35%, #174a94 65%, #122E4D 100% );
            background-attachment: fixed !important;
            min-height: 100vh;
        }

        /* LAYOUT FIX */
        .dashboard-header {
            text-align: center;
            margin-top: 20px;
        }

            .dashboard-header h2 {
                color: #fff !important;
                font-weight: 800;
                margin-bottom: 25px;
            }

        /* STAT CARDS - CENTERED, NOT SPREAD */
        .statistics {
            display: flex;
            justify-content: center;
            gap: 25px;
            flex-wrap: wrap;
        }

        .stat-card {
            background: #fff;
            border-radius: 16px;
            padding: 22px 35px;
            min-width: 200px;
            text-align: center;
            box-shadow: 0 10px 25px rgba(0,0,0,0.18);
        }

            .stat-card h3 {
                font-size: 32px;
                font-weight: 800;
                color: #1857D6;
                margin: 0;
            }

            .stat-card p {
                color: #64748b;
                font-weight: 600;
                font-size: 13px;
                margin-top: 6px;
            }

        hr {
            border-color: rgba(255,255,255,0.2) !important;
            margin: 25px 0;
        }

        /* TABLE - WHITE CARD */
        .table-container {
            background: #fff;
            border-radius: 18px;
            overflow: hidden;
            box-shadow: 0 12px 30px rgba(0,0,0,0.2);
            overflow-x: auto;
        }

        .admin-table {
            width: 100%;
            border-collapse: collapse;
        }

            .admin-table thead {
                background: #1565ff;
                color: #fff;
            }

            .admin-table th {
                padding: 18px 16px;
                text-align: left;
                font-weight: 700;
            }

            .admin-table td {
                padding: 16px;
                border-bottom: 1px solid #eef2f7;
            }

        .status {
            padding: 6px 12px;
            border-radius: 20px;
            font-weight: 700;
            font-size: 12px;
        }

            .status.pending {
                background: #fff3cd;
                color: #856404;
            }

            .status.approved {
                background: #d4edda;
                color: #155724;
            }

            .status.rejected {
                background: #f8d7da;
                color: #721c24;
            }

        .approve-btn {
            background: #1857D6;
            color: #fff;
            padding: 8px 14px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: 600;
        }

        /* YOUR ORIGINAL STYLES - KEPT */
        .tenant-welcome h1,
        .tenant-welcome p,
        .section-heading h2 {
            color: #fff;
        }
        .global-loader {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(255, 255, 255, 0.85);
            z-index: 9999;
            align-items: center;
            justify-content: center;
        }

        .top-bar {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 14px;
            margin-bottom: 10px;
        }

        .profile-pic-circle {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid #fff;
        }

        .profile-pic-fallback {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #fff;
            color: #1857D6;
            font-size: 22px;
            border: 2px solid #fff;
        }

        .global-loader.active {
            display: flex;
        }

        .loader-box {
            text-align: center;
        }

        .house-loader {
            position: relative;
            width: 90px;
            height: 90px;
            margin: 0 auto 15px;
        }

            .house-loader svg {
                width: 100%;
                height: 100%;
            }

        .house-outline {
            stroke: #0087c9;
            stroke-width: 3;
            fill: none;
            stroke-linecap: round;
            stroke-linejoin: round;
            stroke-dasharray: 220;
            stroke-dashoffset: 220;
            animation: draw-house 2.2s ease-in-out infinite;
        }

        .house-key {
            transform-origin: 50px 55px;
            animation: turn-key 2.2s ease-in-out infinite;
        }

            .house-key circle {
                fill: none;
                stroke: #0d6efd;
                stroke-width: 3;
            }

            .house-key line {
                stroke: #0d6efd;
                stroke-width: 3;
                stroke-linecap: round;
            }

        @@keyframes draw-house {
            0% {
                stroke-dashoffset: 220;
                opacity: 0.3;
            }

            50% {
                stroke-dashoffset: 0;
                opacity: 1;
            }

            100% {
                stroke-dashoffset: 0;
                opacity: 0.3;
            }
        }

        @@keyframes turn-key {
            0%, 20% {
                transform: rotate(0deg);
            }

            40% {
                transform: rotate(-25deg);
            }

            60% {
                transform: rotate(15deg);
            }

            80%, 100% {
                transform: rotate(0deg);
            }
        }

        #logout-loader-text {
            font-size: 15px;
            color: #333;
            font-weight: 600;
            min-height: 20px;
            transition: opacity 0.25s ease;
        }

        /* LOGOUT BUTTON WHITE PILL */
       
        .dashboard-header h2 {
            color: #fff;
            font-size: 38px;
            font-weight: bold;
            margin-bottom: 35px;
        }

        body {
            min-height: 100vh;
            background: linear-gradient(180deg, #2d7df7 0%, #1f5fc4 35%, #174a94 65%, #122E4D 100%) fixed;
        }

        .back-pill {
            position: absolute;
            top: 20px;
            left: 20px;
            z-index: 20;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 20px;
            border-radius: 999px;
            border: 1.5px solid rgba(255, 255, 255, .7);
            background: rgba(255, 255, 255, .15);
            color: #ffffff;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.15s ease;
        }

            .back-pill:hover {
                background: #ffffff;
                border-color: #ffffff;
                color: #2563eb;
            }
    </style>
}
<partial name="_AdminSidebar" />
<div class="admin-dashboard">
 <div class="top-bar">

    <a asp-controller="Admin" asp-action="UpdateProfile" title="Update Profile">
        @if (!string.IsNullOrWhiteSpace(Model.ProfileImagePath))
        {
            <img src="@Model.ProfileImagePath" alt="Profile picture" class="profile-pic-circle" />
        }
        else
        {
            <div class="profile-pic-fallback">
                <i class="bi bi-person-fill"></i>
            </div>
        }
    </a>
    <form asp-controller="Account" asp-action="Logout" method="post" id="logoutForm">
        <button type="submit" class="logout-btn">
            <i class="bi bi-box-arrow-right"></i> Logout
        </button>
    </form>
</div>

<div class="dashboard-header">
    <h2>Welcome back, @Model.FirstName !👨‍💼</h2>
    <div class="statistics">
        <div class="stat-card">
            <h3>@Model.PendingApplications</h3>
            <p>Pending Applications</p>
        </div>
        <div class="stat-card">
            <h3>@Model.ApprovedApplications</h3>
            <p>Approved Applications</p>
        </div>
        <div class="stat-card">
            <h3>@Model.RejectedApplications</h3>
            <p>Rejected Applications</p>
        </div>
    </div>
</div>
<hr />
<div class="table-container">
    <table class="admin-table">
        <thead>
            <tr>
                <th>Property</th>
                <th>Landlord</th>
                <th>Location</th>
                <th>Price</th>
                <th>Date</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Applications)
            {
                <tr>
                    <td>@item.PropertyTitle</td>
                    <td>@item.LandlordName</td>
                    <td>@item.Location</td>
                    <td>R @item.Price.ToString("N2")</td>
                    <td>@item.ApplicationDate</td>
                    <td>
                        @if (item.ApplicationStatus == "Pending")
                        {
                            <span class="status pending">Pending</span>
                        }
                        else if (item.ApplicationStatus == "Approved")
                        {
                            <span class="status approved">Approved</span>
                        }
                        else
                        {
                            <span class="status rejected">Rejected</span>
                        }
                    </td>
                    <td class="actions">
                        <a asp-action="ApplicationDetails" asp-route-id="@item.ListingApplicationId" class="approve-btn">🔍 View</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
</div>

<div id="logout-loader" class="global-loader">
    <div class="loader-box">
        <div class="house-loader">
            <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                <path class="house-outline"
                      d="M15 50 L50 20 L85 50 L85 85 L15 85 Z M35 85 L35 60 L65 60 L65 85" />

                <g class="house-key">
                    <circle cx="45" cy="55" r="6" />
                    <line x1="51" y1="55" x2="65" y2="55" />
                    <line x1="60" y1="55" x2="60" y2="61" />
                    <line x1="65" y1="55" x2="65" y2="61" />
                </g>
            </svg>
        </div>

        <p id="logout-loader-text">Locking up...</p>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const form = document.getElementById("logoutForm");
            const loader = document.getElementById("logout-loader");
            const loaderText = document.getElementById("logout-loader-text");
            const adminName = "@Model.FirstName";
            const captions = ["Logging out of the admin panel...", "Securing the dashboard...", "Saving your review queue...", "See you soon, " + adminName + "!"];
            let captionIndex = 0;
            form.addEventListener("submit", function () {
                loaderText.textContent = captions[0];
                loader.classList.add("active");
                setInterval(function () {
                    captionIndex = (captionIndex + 1) % captions.length;
                    loaderText.style.opacity = 0;
                    setTimeout(function () {
                        loaderText.textContent = captions[captionIndex];
                        loaderText.style.opacity = 1;
                    }, 200);
                }, 1200);
            });
        })();
    </script>
}