@model Smart_Stay.Models.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}
@section Styles {
    <link rel="stylesheet"
          href="~/css/AdminSidebar.css"
          asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

    <style>

        .global-loader {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(255, 255, 255, 0.85);
            z-index: 9999;
            align-items: center;
            justify-content: center;
        }

            .global-loader.active {
                display: flex;
            }

        .loader-box {
            text-align: center;
        }

        .house-loader {
            position: relative;
            width: 90px;
            height: 90px;
            margin: 0 auto 15px;
        }

            .house-loader svg {
                width: 100%;
                height: 100%;
            }

        .house-outline {
            stroke: #0087c9;
            stroke-width: 3;
            fill: none;
            stroke-linecap: round;
            stroke-linejoin: round;
            stroke-dasharray: 220;
            stroke-dashoffset: 220;
            animation: draw-house 2.2s ease-in-out infinite;
        }

        .house-key {
            transform-origin: 50px 55px;
            animation: turn-key 2.2s ease-in-out infinite;
        }

            .house-key circle {
                fill: none;
                stroke: #0d6efd;
                stroke-width: 3;
            }

            .house-key line {
                stroke: #0d6efd;
                stroke-width: 3;
                stroke-linecap: round;
            }

        @@keyframes draw-house {
            0% {
                stroke-dashoffset: 220;
                opacity: 0.3;
            }

            50% {
                stroke-dashoffset: 0;
                opacity: 1;
            }

            100% {
                stroke-dashoffset: 0;
                opacity: 0.3;
            }
        }

        @@keyframes turn-key {
            0%, 20% {
                transform: rotate(0deg);
            }

            40% {
                transform: rotate(-25deg);
            }

            60% {
                transform: rotate(15deg);
            }

            80%, 100% {
                transform: rotate(0deg);
            }
        }

        #logout-loader-text {
            font-size: 15px;
            color: #333;
            font-weight: 600;
            min-height: 20px;
            transition: opacity 0.25s ease;
        }

    </style>
}
<partial name="_AdminSidebar" />
<div class="top-bar">
    <form asp-controller="Account"
          asp-action="Logout"
          method="post"
          id="logoutForm">
        <button type="submit" class="logout-btn">
            <i class="bi bi-box-arrow-right"></i>
            Logout
        </button>
    </form>
</div>
<div class="dashboard-header">
    <h2>Welcome back, @Model.FirstName 👨‍💼!</h2>
    <div class="statistics">
        <div class="stat-card">
            <h3>@Model.PendingApplications</h3>
            <p>Pending Applications</p>
        </div>
        <div class="stat-card">
            <h3>@Model.ApprovedApplications</h3>
            <p>Approved Applications</p>
        </div>
        <div class="stat-card">
            <h3>@Model.RejectedApplications</h3>
            <p>Rejected Applications</p>
        </div>
    </div>
</div>
<hr />
<div class="table-container">
    <table class="admin-table">
        <thead>
            <tr>
                <th>Property</th>
                <th>Landlord</th>
                <th>Location</th>
                <th>Price</th>
                <th>Date</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Applications)
            {
                <tr>
                    <td>@item.PropertyTitle</td>
                    <td>@item.LandlordName</td>
                    <td>@item.Location</td>
                    <td>R @item.Price.ToString("N2")</td>
                    <td>@item.ApplicationDate</td>
                    <td>
                        @if (item.ApplicationStatus == "Pending")
                        {
                            <span class="status pending">
                                Pending
                            </span>
                        }
                        else if (item.ApplicationStatus == "Approved")
                        {
                            <span class="status approved">
                                Approved
                            </span>
                        }
                        else
                        {
                            <span class="status rejected">
                                Rejected
                            </span>
                        }
                    </td>
                    <td class="actions">
                        <a asp-action="ApplicationDetails"
                           asp-route-id="@item.ListingApplicationId"
                           class="approve-btn">
                            🔍 View
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div id="logout-loader" class="global-loader">
    <div class="loader-box">

        <div class="house-loader">
            <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">

                <!-- House outline -->
                <path class="house-outline"
                      d="M15 50 L50 20 L85 50 L85 85 L15 85 Z M35 85 L35 60 L65 60 L65 85" />

                <!-- Key -->
                <g class="house-key">
                    <circle cx="45" cy="55" r="6" />
                    <line x1="51" y1="55" x2="65" y2="55" />
                    <line x1="60" y1="55" x2="60" y2="61" />
                    <line x1="65" y1="55" x2="65" y2="61" />
                </g>

            </svg>
        </div>

        <p id="logout-loader-text">Locking up...</p>
    </div>
</div>

@section Scripts {

    <script>

              (function () {
            const form = document.getElementById("logoutForm");
            const loader = document.getElementById("logout-loader");
            const loaderText = document.getElementById("logout-loader-text");

            const adminName = "@Model.FirstName";

            const captions = [
                "Logging out of the admin panel...",
                "Securing the dashboard...",
                "Saving your review queue...",
                "See you soon, " + adminName + "!"
            ];

            let captionIndex = 0;

            form.addEventListener("submit", function () {

                loaderText.textContent = captions[0];
                loader.classList.add("active");

                setInterval(function () {
                    captionIndex = (captionIndex + 1) % captions.length;

                    loaderText.style.opacity = 0;

                    setTimeout(function () {
                        loaderText.textContent = captions[captionIndex];
                        loaderText.style.opacity = 1;
                    }, 200);
                }, 1200);
            });
        })();

    </script>

}