@model Smart_Stay.Models.AdminRegisterViewModel

@{
    ViewData["Title"] = "Register Admin";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Smart Stay - Register Admin</title>

    <link rel="preconnect" href="https://cdnjs.cloudflare.com" />
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <link rel="stylesheet" href="~/css/register.css" />

    <style>
        .pwd-rules {
            list-style: none;
            padding: 0;
            margin: 8px 0 15px;
            font-size: 13px;
        }

            .pwd-rules li {
                display: flex;
                align-items: center;
                gap: 6px;
                color: #888;
                margin-bottom: 4px;
                transition: color 0.2s ease;
            }

                .pwd-rules li i {
                    font-size: 12px;
                    color: #c0392b;
                    transition: color 0.2s ease;
                }

                .pwd-rules li.valid {
                    color: #27ae60;
                    font-weight: bold;
                }

                    .pwd-rules li.valid i {
                        color: #27ae60;
                    }

        .global-loader {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(255, 255, 255, 0.85);
            z-index: 9999;
            align-items: center;
            justify-content: center;
        }

            .global-loader.active {
                display: flex;
            }

        .loader-box {
            text-align: center;
        }

        .house-loader {
            position: relative;
            width: 90px;
            height: 90px;
            margin: 0 auto 15px;
        }

            .house-loader svg {
                width: 100%;
                height: 100%;
            }

        .house-outline {
            stroke: #0087c9;
            stroke-width: 3;
            fill: none;
            stroke-linecap: round;
            stroke-linejoin: round;
            stroke-dasharray: 220;
            stroke-dashoffset: 220;
            animation: draw-house 2.2s ease-in-out infinite;
        }

        .house-key {
            transform-origin: 50px 55px;
            animation: turn-key 2.2s ease-in-out infinite;
        }

            .house-key circle {
                fill: none;
                stroke: #0d6efd;
                stroke-width: 3;
            }

            .house-key line {
                stroke: #0d6efd;
                stroke-width: 3;
                stroke-linecap: round;
            }

        @@keyframes draw-house {
            0% {
                stroke-dashoffset: 220;
                opacity: 0.3;
            }

            50% {
                stroke-dashoffset: 0;
                opacity: 1;
            }

            100% {
                stroke-dashoffset: 0;
                opacity: 0.3;
            }
        }

        @@keyframes turn-key {
            0%, 20% {
                transform: rotate(0deg);
            }

            40% {
                transform: rotate(-25deg);
            }

            60% {
                transform: rotate(15deg);
            }

            80%, 100% {
                transform: rotate(0deg);
            }
        }

        #loader-text {
            font-size: 15px;
            color: #333;
            font-weight: 600;
            min-height: 20px;
            transition: opacity 0.25s ease;
        }

        .close-btn {
            cursor: pointer;
            z-index: 10;
        }

        #logout-loader-text {
            font-size: 15px;
            color: #333;
            font-weight: 600;
            min-height: 20px;
            transition: opacity 0.25s ease;
        }

        .dashboard-header h2 {
            color: #fff;
            font-size: 38px;
            font-weight: bold;
            margin-bottom: 35px;
        }

        body {
            min-height: 100vh;
            background: linear-gradient(180deg, #2d7df7 0%, #1f5fc4 35%, #174a94 65%, #122E4D 100%) fixed;
        }

        .back-pill {
            position: absolute;
            top: 20px;
            left: 20px;
            z-index: 20;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 20px;
            border-radius: 999px;
            border: 1.5px solid rgba(255, 255, 255, .7);
            background: rgba(255, 255, 255, .15);
            color: #ffffff;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.15s ease;
        }

            .back-pill:hover {
                background: #ffffff;
                border-color: #ffffff;
                color: #2563eb;
    </style>
</head>

<body>
   
    <div class="register-wrapper">

        <div class="register-left">

            <!-- X BUTTON: back to the admin dashboard -->
            <a asp-controller="Admin"
               asp-action="Dashboard"
               class="close-btn">

                <i class="fa-solid fa-xmark"></i>

            </a>

            <h2 class="title">REGISTER ADMIN</h2>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="field-error">

                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        if (!string.IsNullOrWhiteSpace(error.ErrorMessage))
                        {
                            <p>@error.ErrorMessage</p>
                        }
                    }

                </div>
            }

            <form asp-controller="Admin"
                  asp-action="RegisterAdmin"
                  method="post"
                  id="registerForm">

                <!-- NAME -->

                <label class="field-label">
                    Name and Surname
                    <span class="required">*Required</span>
                </label>

                <div class="input-group">
                    <i class="fa-solid fa-user"></i>
                    <input asp-for="FullName"
                           type="text"
                           placeholder="Enter name and surname"
                           required />
                </div>


                <!-- EMAIL -->

                <label class="field-label">
                    Email Address
                    <span class="required">*Required</span>
                </label>

                <div class="input-group">
                    <i class="fa-solid fa-envelope"></i>
                    <input asp-for="Email"
                           type="email"
                           placeholder="Enter email"
                           required />
                </div>


                <!-- PHONE -->

                <label class="field-label">
                    Phone Number
                    <span class="required">*Required</span>
                </label>

                <div class="input-group">
                    <i class="fa-solid fa-phone"></i>
                    <input asp-for="PhoneNo"
                           type="tel"
                           id="phoneNo"
                           placeholder="Phone number e.g 0786739981"
                           maxlength="10"
                           minlength="10"
                           pattern="[0-9]{10}"
                           inputmode="numeric"
                           required />
                </div>


                <!-- PASSWORD -->

                <label class="field-label">
                    Password
                    <span class="required">*Required</span>
                </label>

                <div class="input-group">
                    <i class="fa-solid fa-lock"></i>
                    <input asp-for="Password"
                           type="password"
                           id="passwordField"
                           placeholder="Enter a strong password"
                           required
                           autocomplete="new-password"
                           pattern="^(?=.*[A-Z])(?=.*\d)(?=.*[!@@#$%^&*(),.?&quot;:{}|&lt;&gt;]).{8,}$"
                           title="At least 8 characters, 1 uppercase letter, 1 number, and 1 special character" />

                    <i class="fa-solid fa-eye toggle-eye"
                       onclick="toggleField('passwordField')">
                    </i>
                </div>


                <!-- PASSWORD RULES -->

                <ul id="pwdRules" class="pwd-rules">
                    <li id="ruleLength">
                        <i class="fa-solid fa-circle-xmark"></i>
                        At least 8 characters
                    </li>
                    <li id="ruleUpper">
                        <i class="fa-solid fa-circle-xmark"></i>
                        1 uppercase letter
                    </li>
                    <li id="ruleNumber">
                        <i class="fa-solid fa-circle-xmark"></i>
                        1 number
                    </li>
                    <li id="ruleSpecial">
                        <i class="fa-solid fa-circle-xmark"></i>
                        1 special character
                    </li>
                </ul>


                <!-- CONFIRM PASSWORD -->

                <label class="field-label">
                    Confirm Password
                    <span class="required">*Required</span>
                </label>

                <div class="input-group">
                    <i class="fa-solid fa-lock"></i>
                    <input asp-for="ConfirmPassword"
                           type="password"
                           id="confirmField"
                           placeholder="Confirm password"
                           required
                           autocomplete="new-password" />

                    <i class="fa-solid fa-eye toggle-eye"
                       onclick="toggleField('confirmField')">
                    </i>
                </div>

                <p id="confirmError"
                   class="field-error"
                   style="display:none;">
                    Passwords do not match
                </p>


                <!-- REGISTER BUTTON -->

                <button type="submit"
                        class="btn-register"
                        id="registerButton">
                    Register Admin
                </button>

            </form>

            <!-- BACK LINK -->

            <p class="login-text">
                <a asp-controller="Admin" asp-action="Dashboard">
                    Back to Dashboard
                </a>
            </p>

        </div>


        <!-- RIGHT SIDE -->

        <div class="register-right">

            <div class="right-content">

                <div class="right-brand">
                    <h3>SMART STAY</h3>
                    <p>YOUR TRUSTED RENTAL PARTNER</p>
                </div>

                <div class="right-features">
                    <p>Easy property listing</p>
                    <p>24/7 customer support</p>
                    <p>Instant help seamless renting</p>
                </div>

            </div>

        </div>

    </div>


    <!-- GLOBAL LOADER -->

    <div id="global-loader" class="global-loader">

        <div class="loader-box">

            <div class="house-loader">

                <svg viewBox="0 0 100 100"
                     xmlns="http://www.w3.org/2000/svg">

                    <path class="house-outline"
                          d="M15 50 L50 20 L85 50 L85 85 L15 85 Z M35 85 L35 60 L65 60 L65 85" />

                    <g class="house-key">
                        <circle cx="45" cy="55" r="6" />
                        <line x1="51" y1="55" x2="65" y2="55" />
                        <line x1="60" y1="55" x2="60" y2="61" />
                        <line x1="65" y1="55" x2="65" y2="61" />
                    </g>

                </svg>

            </div>

            <p id="loader-text">Creating admin account...</p>

        </div>

    </div>


    <script>

        /* PASSWORD SHOW / HIDE */

        function toggleField(id) {
            const field = document.getElementById(id);
            if (!field) return;
            field.type = field.type === 'password' ? 'text' : 'password';
        }


        /* PASSWORD RULES */

        const pwdField = document.getElementById('passwordField');

        const rules = {
            ruleLength: function (pwd) { return pwd.length >= 8; },
            ruleUpper: function (pwd) { return /[A-Z]/.test(pwd); },
            ruleNumber: function (pwd) { return /\d/.test(pwd); },
            ruleSpecial: function (pwd) { return /[!@@#$%^&*(),.?":{}|<>]/.test(pwd); }
        };

        function updatePasswordRules() {
            if (!pwdField) return;

            const value = pwdField.value;

            for (const [id, check] of Object.entries(rules)) {
                const element = document.getElementById(id);
                if (!element) continue;

                const icon = element.querySelector('i');
                const passed = check(value);

                element.classList.toggle('valid', passed);

                if (icon) {
                    icon.classList.toggle('fa-circle-xmark', !passed);
                    icon.classList.toggle('fa-circle-check', passed);
                }
            }
        }

        function isPasswordValid() {
            if (!pwdField) return false;
            const password = pwdField.value;

            return (
                password.length >= 8 &&
                /[A-Z]/.test(password) &&
                /\d/.test(password) &&
                /[!@@#$%^&*(),.?":{}|<>]/.test(password)
            );
        }


        /* CONFIRM PASSWORD */

        const confirmField = document.getElementById('confirmField');
        const confirmError = document.getElementById('confirmError');

        function checkPasswordsMatch() {
            if (!pwdField || !confirmField) return false;

            const match = pwdField.value === confirmField.value;

            if (confirmError) {
                confirmError.style.display =
                    confirmField.value.length > 0 && !match ? 'block' : 'none';
            }

            return match;
        }

        document.addEventListener('DOMContentLoaded', updatePasswordRules);

        if (pwdField) {
            pwdField.addEventListener('input', function () {
                updatePasswordRules();
                checkPasswordsMatch();
            });
        }

        if (confirmField) {
            confirmField.addEventListener('input', checkPasswordsMatch);
        }


        /* PHONE NUMBER */

        const phoneInput = document.getElementById("phoneNo");

        if (phoneInput) {
            phoneInput.addEventListener("input", function () {
                this.value = this.value.replace(/\D/g, "").slice(0, 10);
            });
        }


        /* FORM SUBMIT + LOADER */

        (function () {

            const form = document.getElementById("registerForm");
            const loader = document.getElementById("global-loader");
            const loaderText = document.getElementById("loader-text");
            const registerButton = document.getElementById("registerButton");

            if (!form || !loader || !loaderText) return;

            const captions = [
                "Creating admin account...",
                "Setting up the new admin...",
                "Handing over the keys..."
            ];

            let captionIndex = 0;

            form.addEventListener("submit", function (e) {

                if (!form.checkValidity()) {
                    e.preventDefault();
                    form.reportValidity();
                    return;
                }

                if (!isPasswordValid()) {
                    e.preventDefault();
                    updatePasswordRules();
                    pwdField.focus();
                    return;
                }

                if (!checkPasswordsMatch()) {
                    e.preventDefault();
                    confirmField.focus();
                    return;
                }

                loaderText.textContent = captions[0];
                loader.classList.add("active");

                if (registerButton) {
                    registerButton.disabled = true;
                }

                setInterval(function () {
                    captionIndex = (captionIndex + 1) % captions.length;
                    loaderText.style.opacity = 0;

                    setTimeout(function () {
                        loaderText.textContent = captions[captionIndex];
                        loaderText.style.opacity = 1;
                    }, 150);
                }, 2200);

            });

        })();

    </script>

</body>
</html>