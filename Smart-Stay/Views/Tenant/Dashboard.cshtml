
@model Smart_Stay.Models.TenantDashboardViewModel

@{
    ViewData["Title"] = "Tenant Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/tenant-dashboard.css" asp-append-version="true" />
}

<div class="tenant-dashboard">

    <div class="sidebar-container">

        <button class="menu-toggle" onclick="toggleMenu()">
            ☰
        </button>

        <div class="sidebar" id="sidebar">

            <h3>Tenant Menu</h3>

            <a asp-controller="Tenant" asp-action="Dashboard">
                <i class="bi bi-speedometer2"></i>
                Dashboard
            </a>

            <a href="#applications">
                <i class="bi bi-file-earmark-text-fill"></i>
                My Applications
            </a>

            <a asp-controller="Tenant" asp-action="BrowseProperties">
                <i class="bi bi-search"></i>
                Browse Properties
            </a>

            <a asp-controller="Tenant" asp-action="UpdateProfile">
                <i class="bi bi-person-circle"></i>
                Update Profile
            </a>

            <a asp-controller="Home" asp-action="Index">
                <i class="bi bi-house-door"></i>
                Back to Main Site
            </a>

        </div>

    </div>

    <main class="tenant-main expanded" id="tenantMain">

        <div class="tenant-header">

            <div class="tenant-welcome">

                <h1>
                    Welcome back, @Model.TenantName! 🏠
                </h1>

                <p>
                    Track your accommodation applications
                    and manage your rental journey.
                </p>

            </div>

            <form asp-controller="Account"
                  asp-action="Logout"
                  method="post">

                @Html.AntiForgeryToken()

                <button type="submit" class="tenant-logout">
                    Logout
                </button>

            </form>

        </div>

        <section class="dashboard-summary">

            <div class="summary-card">
                <div class="summary-number">
                    @Model.TotalApplications
                </div>
                <div class="summary-title">
                    Total Applications
                </div>
            </div>

            <div class="summary-card">
                <div class="summary-number">
                    @Model.ApprovedApplications
                </div>
                <div class="summary-title">
                    Approved
                </div>
            </div>

            <div class="summary-card">
                <div class="summary-number">
                    @Model.PendingApplications
                </div>
                <div class="summary-title">
                    Pending
                </div>
            </div>

            <div class="summary-card">
                <div class="summary-number">
                    @Model.RejectedApplications
                </div>
                <div class="summary-title">
                    Rejected
                </div>
            </div>

        </section>

        <section class="applications-section" id="applications">

            <div class="section-heading">

                <h2>
                    My Accommodations
                </h2>

                <a asp-controller="Tenant"
                   asp-action="BrowseProperties">
                    Browse Properties
                </a>

            </div>

            <div class="accommodation-filters">

                <button type="button"
                        class="filter-pill active"
                        data-filter="Current">
                    Current
                </button>

                <button type="button"
                        class="filter-pill"
                        data-filter="Past">
                    Past
                </button>

                <button type="button"
                        class="filter-pill"
                        data-filter="Rejected">
                    Rejected
                </button>

            </div>

            @if (Model.Applications != null &&
                        Model.Applications.Any())
            {

                <div class="tenant-application-grid"
                     id="accommodationGrid">

                    @foreach (var application in Model.Applications)
                    {

                        <div class="tenant-property-card"
                             data-category="@application.FilterCategory">

                            <div class="tenant-property-image">

                                @if (!string.IsNullOrEmpty(application.ImagePath))
                                {
                                    <img src="@application.ImagePath"
                                         alt="@application.PropertyTitle" />
                                }
                                else
                                {
                                    <div class="no-property-image">
                                        🏠
                                    </div>
                                }

                            </div>

                            <div class="tenant-property-content">

                                <h3>
                                    @application.PropertyTitle
                                </h3>

                                <!-- LOCATION -->
                                <p class="property-location">
                                    <i class="fa-solid fa-location-dot"></i>
                                    @application.Location
                                </p>

                                <!-- BEDROOMS -->
                                <p>
                                    <i class="fa-solid fa-bed"></i>
                                    @application.Bedrooms Bedrooms
                                </p>

                                <!-- BATHROOMS -->
                                <p>
                                    <i class="fa-solid fa-bath"></i>
                                    @application.Bathrooms Bathrooms
                                </p>

                                <!-- PRICE -->
                                <p class="property-price">
                                    <i class="fa-solid fa-money-bill"></i>
                                    R @application.Price.ToString("N2") / Month
                                </p>

                                <p class="application-date">
                                    Applied:
                                    @application.ApplicationDate.ToString("dd MMM yyyy")
                                </p>

                                @if (application.LeaseStartDate.HasValue &&
                                                        application.LeaseEndDate.HasValue)
                                {
                                    <p class="application-date">
                                        Lease:
                                        @application.LeaseStartDate.Value.ToString("dd MMM yyyy")
                                        to
                                        @application.LeaseEndDate.Value.ToString("dd MMM yyyy")
                                    </p>
                                }

                                <div class="application-status">

                                    @if (application.ApplicationStatus == "Approved")
                                    {
                                        <span class="status approved">
                                            ✓ Approved
                                        </span>
                                    }
                                    else if (application.ApplicationStatus == "Pending")
                                    {
                                        <span class="status pending">
                                            ⏳ Pending
                                        </span>
                                    }
                                    else if (application.ApplicationStatus == "Rejected")
                                    {
                                        <span class="status rejected">
                                            ✕ Rejected
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status">
                                            @application.ApplicationStatus
                                        </span>
                                    }

                                </div>

                                <!-- BUTTONS — KEPT SIDE-BY-SIDE -->
                                <a asp-controller="Properties"
                                   asp-action="Details"
                                   asp-route-id="@application.PropertyId"
                                   class="view-property-button">
                                    View Property
                                </a>

                                @if (application.CanRate &&
                                                        !application.HasRated)
                                {
                                    <a asp-controller="Tenant"
                                       asp-action="RateProperty"
                                       asp-route-applicationId="@application.RentalApplicationId"
                                       class="rate-property-button">
                                        ⭐ Rate Property
                                    </a>
                                }
                                else if (application.HasRated)
                                {
                                    <span class="already-rated">
                                        ✓ Rated
                                    </span>
                                }

                            </div>

                        </div>

                    }

                </div>

                <p class="no-applications"
                   id="noFilterResults"
                   style="display:none;">
                    No accommodations in this category.
                </p>

            }
            else
            {

                <div class="no-applications">

                    <div class="no-applications-icon">
                        🏠
                    </div>

                    <h3>
                        You haven't applied for any
                        accommodation yet.
                    </h3>

                    <p>
                        Browse available properties and find
                        a place that feels like home.
                    </p>

                    <a asp-controller="Tenant"
                       asp-action="BrowseProperties"
                       class="browse-button">
                        Browse Properties
                    </a>

                </div>

            }

        </section>

    </main>

</div>

@section Scripts {

    <script>

        function toggleMenu() {
            var sidebar = document.getElementById("sidebar");
            sidebar.classList.toggle("show");
        }

        const filterButtons =
            document.querySelectorAll(".filter-pill");

        const propertyCards =
            document.querySelectorAll(".tenant-property-card");

        const noResultsMsg =
            document.getElementById("noFilterResults");

        function applyFilter(category) {
            let visibleCount = 0;

            propertyCards.forEach(card => {

                if (card.dataset.category === category) {
                    card.style.display = "";
                    visibleCount++;
                }
                else {
                    card.style.display = "none";
                }

            });

            if (noResultsMsg) {
                noResultsMsg.style.display =
                    visibleCount === 0 ? "block" : "none";
            }
        }

        filterButtons.forEach(button => {

            button.addEventListener("click", function () {

                filterButtons.forEach(b =>
                    b.classList.remove("active"));

                this.classList.add("active");

                applyFilter(this.dataset.filter);

            });

        });

        if (propertyCards.length > 0) {
            applyFilter("Current");
        }

    </script>

}
