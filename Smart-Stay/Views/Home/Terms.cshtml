@{
    ViewData["Title"] = "Terms & Conditions";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/terms.css"
          asp-append-version="true" />
}

<div class="terms-page">

    <!-- HEADER -->
    <div class="terms-header">

        <div class="terms-header-icon">
            <i class="bi bi-file-earmark-text-fill"></i>
        </div>

        <h1>Terms & Conditions</h1>

        <p>
            Please read these terms carefully before using
            the Smart Stay platform.
        </p>

    </div>


    <!-- BACK BUTTON -->
    <div class="terms-back">

        <a href="javascript:history.back()" class="terms-back-btn">
            <i class="bi bi-arrow-left"></i>
            Back
        </a>

    </div>


    <!-- TERMS CONTENT -->
    <div class="terms-container">

        <!-- 1 -->
        <section class="terms-section">

            <div class="terms-section-title">
                <span>01</span>
                <h2>Acceptance of Terms</h2>
            </div>

            <p>
                By accessing or using Smart Stay, you agree to comply
                with these Terms & Conditions.
            </p>

            <p>
                If you do not agree with these terms, you should not
                use the Smart Stay platform.
            </p>

        </section>


        <!-- 2 -->
        <section class="terms-section">

            <div class="terms-section-title">
                <span>02</span>
                <h2>About Smart Stay</h2>
            </div>

            <p>
                Smart Stay is an accommodation platform designed to
                connect tenants with landlords and available
                accommodation.
            </p>

            <p>
                Smart Stay provides tools for users to browse properties,
                submit applications and manage property-related
                information.
            </p>

        </section>


        <!-- 3 -->
        <section class="terms-section">

            <div class="terms-section-title">
                <span>03</span>
                <h2>User Accounts</h2>
            </div>

            <p>
                Users must provide accurate information when creating
                an account.
            </p>

            <ul>
                <li>You must provide a valid email address.</li>
                <li>You are responsible for keeping your password secure.</li>
                <li>You must not share your account credentials with others.</li>
                <li>You must provide truthful information when using Smart Stay.</li>
            </ul>

        </section>


        <!-- 4 -->
        <section class="terms-section">

            <div class="terms-section-title">
                <span>04</span>
                <h2>Tenant Responsibilities</h2>
            </div>

            <p>
                Tenants are responsible for ensuring that the information
                they provide during applications is accurate and complete.
            </p>

            <p>
                Tenants should review property information carefully before
                submitting an application or making accommodation decisions.
            </p>

        </section>


        <!-- 5 -->
        <section class="terms-section">

            <div class="terms-section-title">
                <span>05</span>
                <h2>Landlord Responsibilities</h2>
            </div>

            <p>
                Landlords are responsible for providing accurate information
                about their properties.
            </p>

            <ul>
                <li>Property information should be accurate.</li>
                <li>Uploaded documents should belong to the relevant property.</li>
                <li>Property images should accurately represent the accommodation.</li>
                <li>Landlords must not provide misleading property information.</li>
            </ul>

        </section>


        <!-- 6 -->
        <section class="terms-section">

            <div class="terms-section-title">
                <span>06</span>
                <h2>Property Listings</h2>
            </div>

            <p>
                Property listings may be reviewed and verified by Smart Stay
                administrators before becoming available to users.
            </p>

            <p>
                Smart Stay reserves the right to remove or restrict listings
                that violate these terms or contain inaccurate information.
            </p>

        </section>


        <!-- 7 -->
        <section class="terms-section">

            <div class="terms-section-title">
                <span>07</span>
                <h2>Applications</h2>
            </div>

            <p>
                Submitting an application for a property does not
                automatically guarantee that the tenant will be accepted.
            </p>

            <p>
                Application decisions may depend on the landlord's
                requirements and the information provided by the tenant.
            </p>

        </section>


        <!-- 8 -->
        <section class="terms-section">

            <div class="terms-section-title">
                <span>08</span>
                <h2>Reviews & Feedback</h2>
            </div>

            <p>
                Users who are permitted to submit reviews must provide
                honest and relevant feedback.
            </p>

            <p>
                Reviews must not contain offensive, misleading,
                threatening or inappropriate content.
            </p>

        </section>


        <!-- 9 -->
        <section class="terms-section">

            <div class="terms-section-title">
                <span>09</span>
                <h2>Prohibited Activities</h2>
            </div>

            <p>
                Users must not use Smart Stay to:
            </p>

            <ul>
                <li>Provide false or misleading information.</li>
                <li>Attempt to access another user's account.</li>
                <li>Upload harmful or inappropriate content.</li>
                <li>Misuse the platform or its features.</li>
                <li>Attempt to interfere with the security of the platform.</li>
                <li>Use Smart Stay for unlawful purposes.</li>
            </ul>

        </section>


        <!-- 10 -->
        <section class="terms-section">

            <div class="terms-section-title">
                <span>10</span>
                <h2>Account Suspension</h2>
            </div>

            <p>
                Smart Stay may restrict, suspend or terminate an account
                where there is evidence of misuse, fraudulent activity,
                violation of these terms or other behaviour that may
                compromise the platform.
            </p>

        </section>


        <!-- 11 -->
        <section class="terms-section">

            <div class="terms-section-title">
                <span>11</span>
                <h2>Platform Availability</h2>
            </div>

            <p>
                Smart Stay aims to keep the platform available and
                functional, but temporary interruptions may occur due
                to maintenance, technical problems or other circumstances.
            </p>

        </section>


        <!-- 12 -->
        <section class="terms-section">

            <div class="terms-section-title">
                <span>12</span>
                <h2>Limitation of Responsibility</h2>
            </div>

            <p>
                Smart Stay provides the platform as a service for connecting
                tenants and landlords. Users are responsible for verifying
                information and making their own decisions regarding
                accommodation.
            </p>

            <p>
                Smart Stay should not be considered a substitute for
                appropriate checks, agreements or legal advice relating
                to a rental arrangement.
            </p>

        </section>


        <!-- 13 -->
        <section class="terms-section">

            <div class="terms-section-title">
                <span>13</span>
                <h2>Privacy</h2>
            </div>

            <p>
                Your use of Smart Stay is also subject to our
                Privacy Policy, which explains how information is
                collected and handled.
            </p>

            <a asp-controller="Home"
               asp-action="Privacy"
               class="terms-inline-link">

                View Privacy Policy
                <i class="bi bi-arrow-right"></i>

            </a>

        </section>


        <!-- 14 -->
        <section class="terms-section">

            <div class="terms-section-title">
                <span>14</span>
                <h2>Changes to These Terms</h2>
            </div>

            <p>
                Smart Stay may update these Terms & Conditions from
                time to time as the platform develops.
            </p>

            <p>
                Updated terms will be made available on this page.
            </p>

        </section>


        <!-- 15 -->
        <section class="terms-section">

            <div class="terms-section-title">
                <span>15</span>
                <h2>Contact Us</h2>
            </div>

            <p>
                If you have questions about these Terms & Conditions,
                please contact Smart Stay.
            </p>

            <div class="terms-contact">

                <i class="bi bi-envelope-fill"></i>

                <div>
                    <strong>Email</strong>
                    <span>smartstay729@gmail.com</span>
                </div>

            </div>

        </section>

    </div>


    <!-- CTA -->
    <div class="terms-cta">

        <div>

            <h2>Have questions about our terms?</h2>

            <p>
                Contact the Smart Stay team if you need further
                clarification.
            </p>

        </div>

        <a asp-controller="Home"
           asp-action="Contact"
           class="terms-contact-btn">

            <i class="bi bi-envelope"></i>
            Contact Us

        </a>

    </div>

</div>