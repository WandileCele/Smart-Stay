@model List<Smart_Stay.Models.PropertyCardViewModel>
@{
    ViewData["Title"] = "Smart Stay";
}

<div class="hero">

    <nav>

        <div class="logo">
            <img src="~/images/download (3).jpg" />
            <h1>SMART STAY</h1>
        </div>

        <div class="buttons">
            <a asp-controller="Account" asp-action="Register" class="btn">
                SIGN UP
            </a>
            <a asp-controller="Account" asp-action="Login" class="btn">
                LOG IN
            </a>
        </div>

    </nav>

    <div class="hero-content">

        <h2>
            FIND THE PERFECT ACCOMMODATION IN PORT ELIZABETH
        </h2>

        <div class="search-box">

            <input type="text"
                   placeholder="Search Property e.g Sarah Bartman">

            <button>

                🔍

            </button>

        </div>

        <div class="filters">

            <select>

                <option>Filter by location</option>

                <option>Walmer</option>

                <option>Humewood</option>

                <option>Summerstrand</option>

            </select>

            <select>

                <option>Filter by price</option>

                <option>R2000-R3000</option>

                <option>R3000-R5000</option>

                <option>R5000+</option>

            </select>

        </div>

    </div>


</div>
<section class="popular">

  <div class="title">

    <h2>POPULAR ACCOMMODATION</h2>

    <a asp-controller="Properties"
       asp-action="viewAll">

        VIEW ALL

    </a>

</div>
    <div class="cards">

       
        @foreach (var item in Model)
        {
            <a class="property-link"
               asp-controller="Properties"
               asp-action="Details"
               asp-route-id="@item.PropertyID">

                <div class="card">

                    <img src="@item.ImagePath" alt="@item.Title" />

                    <h3>@item.Title</h3>

                    <p>
                        <i class="fa-solid fa-bed"></i>
                        @item.Bedrooms Bedrooms
                    </p>

                    <p>
                        <i class="fa-solid fa-bath"></i>
                        @item.Bathrooms Bathrooms
                    </p>

                    <p>
                        <i class="fa-solid fa-location-dot"></i>
                        @item.Location
                    </p>

                    <h4>
                        <i class="fa-solid fa-money-bill"></i>
                        R @item.Price / PM
                    </h4>

                    <div class="rating">

                        @if (item.AverageRating.HasValue)
                        {
                            var fullStars = (int)Math.Floor(item.AverageRating.Value);
                            var hasHalfStar = item.AverageRating.Value - fullStars >= 0.5;

                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= fullStars)
                                {
                                    <i class="fa-solid fa-star"></i>
                                }
                                else if (i == fullStars + 1 && hasHalfStar)
                                {
                                    <i class="fa-solid fa-star-half-stroke"></i>
                                }
                                else
                                {
                                    <i class="fa-regular fa-star"></i>
                                }
                            }

                            <span>
                                @item.AverageRating.Value.ToString("0.0")
                                (@item.ReviewCount)
                            </span>
                        }
                        else
                        {
                            <span class="no-rating">
                                ☆ No ratings yet
                            </span>
                        }

                    </div>

                </div>

            </a>
        }
       
    </div>


</section>